{{ 'horizon-botanical.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} footer.hb-footer {
    background-color: {{ section.settings.background_color | default: '#15331e' }};
    color: {{ section.settings.text_color | default: '#d1e2d4' }};
    padding-top: {{ section.settings.padding_top | default: 64 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;
    {% if section.settings.border_top_width > 0 %}
      border-top: {{ section.settings.border_top_width }}px solid {{ section.settings.border_top_color | default: '#204b2e' }};
    {% else %}
      border-top: none;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .hb-footer-col h4 {
    color: {{ section.settings.heading_color | default: '#ffffff' }};
    font-size: {{ section.settings.heading_size | default: 16 }}px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 20px;
  }

  #shopify-section-{{ section.id }} .hb-footer-about {
    color: {{ section.settings.text_color | default: '#d1e2d4' }};
    font-size: {{ section.settings.text_size | default: 14 }}px;
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .hb-footer-links li {
    color: {{ section.settings.text_color | default: '#d1e2d4' }};
    font-size: {{ section.settings.link_size | default: 14 }}px;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .hb-footer-links a {
    color: {{ section.settings.link_color | default: '#d1e2d4' }};
    font-size: {{ section.settings.link_size | default: 14 }}px;
    text-decoration: none;
    transition: color 0.25s ease, transform 0.25s ease;
  }

  #shopify-section-{{ section.id }} .hb-footer-links a:hover {
    color: {{ section.settings.link_hover_color | default: '#68d391' }};
    transform: translateX(3px);
  }

  #shopify-section-{{ section.id }} .hb-footer-bottom {
    border-top: 1px solid {{ section.settings.bottom_bar_border_color | default: '#204b2e' }};
    color: {{ section.settings.copyright_color | default: '#a3bfa8' }};
    font-size: {{ section.settings.copyright_size | default: 13 }}px;
  }
{%- endstyle -%}

<footer class="hb-footer">
  <div class="hb-container">
    <div class="hb-footer-grid">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'brand_info' %}
            <div class="hb-footer-col" {{ block.shopify_attributes }}>
              <div class="hb-footer-brand">
                {% if block.settings.logo != blank %}
                  {{ block.settings.logo | image_url: width: 300 | image_tag: loading: 'lazy', alt: shop.name, style: 'max-width: 100%; height: auto;' }}
                {% else %}
                  <img src="{{ 'horizon-logo.svg' | asset_url }}" alt="{{ shop.name }}" width="{{ block.settings.logo_width | default: 150 }}" height="38">
                {% endif %}
              </div>
              {% if block.settings.about_text != blank %}
                <p class="hb-footer-about" style="{% if block.settings.custom_text_color != blank %}color: {{ block.settings.custom_text_color }};{% endif %}">{{ block.settings.about_text }}</p>
              {% endif %}
            </div>

          {% when 'link_column' %}
            {%- assign blk_heading_col = block.settings.custom_heading_color | default: section.settings.heading_color | default: '#ffffff' -%}
            {%- assign blk_link_col = block.settings.custom_link_color | default: section.settings.link_color | default: '#d1e2d4' -%}

            <div class="hb-footer-col" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h4 style="color: {{ blk_heading_col }};">{{ block.settings.heading }}</h4>
              {% endif %}
              <ul class="hb-footer-links">
                {% if block.settings.menu != blank and linklists[block.settings.menu].links.size > 0 %}
                  {% for link in linklists[block.settings.menu].links %}
                    <li><a href="{{ link.url }}" style="color: {{ blk_link_col }};">{{ link.title }}</a></li>
                  {% endfor %}
                {% else %}
                  {% if block.settings.heading contains 'Customer' or block.settings.heading contains 'Care' %}
                    <li><a href="/pages/shipping" style="color: {{ blk_link_col }};">Shipping Policy</a></li>
                    <li><a href="/pages/refunds" style="color: {{ blk_link_col }};">Refund & Return Policy</a></li>
                    <li><a href="/pages/privacy" style="color: {{ blk_link_col }};">Privacy Policy</a></li>
                    <li><a href="/pages/terms" style="color: {{ blk_link_col }};">Terms of Service</a></li>
                    <li><a href="#faq" style="color: {{ blk_link_col }};">Support Center</a></li>
                  {% else %}
                    <li><a href="/" style="color: {{ blk_link_col }};">Home</a></li>
                    <li><a href="/collections/all" style="color: {{ blk_link_col }};">All Products</a></li>
                    <li><a href="#ingredients" style="color: {{ blk_link_col }};">Our Ingredients</a></li>
                    <li><a href="#faq" style="color: {{ blk_link_col }};">Frequently Asked</a></li>
                    <li><a href="/pages/track-order" style="color: {{ blk_link_col }};">Track My Order</a></li>
                  {% endif %}
                {% endif %}
              </ul>
            </div>

          {% when 'contact_column' %}
            {%- assign blk_cnt_heading = block.settings.custom_heading_color | default: section.settings.heading_color | default: '#ffffff' -%}
            <div class="hb-footer-col" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h4 style="color: {{ blk_cnt_heading }};">{{ block.settings.heading }}</h4>
              {% endif %}
              <ul class="hb-footer-links">
                {% if block.settings.email != blank %}
                  <li><a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a></li>
                {% endif %}
                {% if block.settings.phone != blank %}
                  <li><a href="tel:{{ block.settings.phone }}">{{ block.settings.phone }}</a></li>
                {% endif %}
                {% if block.settings.hours != blank %}
                  <li>{{ block.settings.hours }}</li>
                {% endif %}
                {% if block.settings.delivery_badge != blank %}
                  <li>{{ block.settings.delivery_badge }}</li>
                {% endif %}
                {% if block.settings.eco_badge != blank %}
                  <li>{{ block.settings.eco_badge }}</li>
                {% endif %}
              </ul>
            </div>
        {% endcase %}
      {% endfor %}
    </div>

    <div class="hb-footer-bottom">
      <div>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_text }}</div>
      {% if section.settings.show_payment_icons %}
        <div class="hb-payment-badges">
          <svg width="38" height="24" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="3" fill="#ffffff" stroke="#e0e0e0"/><path d="M15 17L17 7H20L18 17H15Z" fill="#1434CB"/><path d="M25 7.2C24.3 7 23.3 6.8 22.1 6.8C19.3 6.8 17.3 8.3 17.3 10.4C17.3 12 18.7 12.8 19.8 13.3C20.9 13.8 21.3 14.2 21.3 14.7C21.3 15.5 20.3 15.9 19.4 15.9C18.1 15.9 17.3 15.6 16.5 15.2L16.1 15L15.7 17.2C16.4 17.5 17.7 17.8 19.1 17.8C22.1 17.8 24 16.3 24 14.1C24 12.8 23.2 11.8 21.5 11C20.5 10.5 19.9 10.2 19.9 9.6C19.9 9.1 20.5 8.6 21.7 8.6C22.6 8.6 23.4 8.8 23.9 9.1L24.2 9.2L25 7.2Z" fill="#1434CB"/></svg>
          <svg width="38" height="24" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="3" fill="#ffffff" stroke="#e0e0e0"/><circle cx="15" cy="12" r="7" fill="#EB001B"/><circle cx="23" cy="12" r="7" fill="#F79E1B" fill-opacity="0.8"/></svg>
          {% if section.settings.show_cod_badge %}
            <svg width="38" height="24" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="3" fill="#ffffff" stroke="#e0e0e0"/><rect x="6" y="8" width="26" height="8" rx="2" fill="#257942"/><text x="19" y="14" font-size="6" font-weight="700" fill="#ffffff" text-anchor="middle" font-family="sans-serif">COD</text></svg>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Botanical Footer",
  "settings": [
    {
      "type": "header",
      "content": "Footer Background & Borders"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#15331e"
    },
    {
      "type": "range",
      "id": "border_top_width",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "label": "Top Divider Border Width",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_top_color",
      "label": "Top Divider Border Color",
      "default": "#204b2e"
    },
    {
      "type": "header",
      "content": "Headings & Typography"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Column Headings Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 13,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Column Headings Font Size",
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body / Brand Text Color",
      "default": "#d1e2d4"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Body / Brand Font Size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Navigation Links"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Links Color",
      "default": "#d1e2d4"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Links Hover Color",
      "default": "#68d391"
    },
    {
      "type": "range",
      "id": "link_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Links Font Size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Bottom Bar & Copyright"
    },
    {
      "type": "color",
      "id": "bottom_bar_border_color",
      "label": "Bottom Divider Border Color",
      "default": "#204b2e"
    },
    {
      "type": "color",
      "id": "copyright_color",
      "label": "Copyright Text Color",
      "default": "#a3bfa8"
    },
    {
      "type": "range",
      "id": "copyright_size",
      "min": 11,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Copyright Font Size",
      "default": 13
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "All rights reserved. Powered by Shopify Horizon."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show Payment Icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cod_badge",
      "label": "Show Cash on Delivery (COD) Badge",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "brand_info",
      "name": "Brand Column",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Custom Footer Logo"
        },
        {
          "type": "range",
          "id": "logo_width",
          "min": 80,
          "max": 240,
          "step": 10,
          "unit": "px",
          "label": "Logo Width",
          "default": 150
        },
        {
          "type": "textarea",
          "id": "about_text",
          "label": "About Text",
          "default": "Pure, plant-powered botanical drops formulated for natural everyday comfort, restorative joint care, and effortless daily movement."
        },
        {
          "type": "color",
          "id": "custom_text_color",
          "label": "Custom Text Color (Optional)"
        }
      ]
    },
    {
      "type": "link_column",
      "name": "Menu Links Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column Heading",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Navigation Menu"
        },
        {
          "type": "color",
          "id": "custom_heading_color",
          "label": "Custom Heading Color (Optional)"
        },
        {
          "type": "color",
          "id": "custom_link_color",
          "label": "Custom Link Color (Optional)"
        }
      ]
    },
    {
      "type": "contact_column",
      "name": "Contact / Badges",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column Heading",
          "default": "Contact Us"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Support Email",
          "default": "hello@tierabotanicals.com"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone / WhatsApp",
          "default": "+1 (800) 555-0199"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Business Hours",
          "default": "Mon – Fri: 9:00 AM – 6:00 PM"
        },
        {
          "type": "text",
          "id": "delivery_badge",
          "label": "Shipping Badge Note",
          "default": "Direct Tracked Express Delivery"
        },
        {
          "type": "text",
          "id": "eco_badge",
          "label": "Sustainability Badge Note",
          "default": "100% Eco-Sustainable Packaging"
        },
        {
          "type": "color",
          "id": "custom_heading_color",
          "label": "Custom Heading Color (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Botanical Footer",
      "blocks": [
        {
          "type": "brand_info",
          "settings": {
            "about_text": "Pure, plant-powered botanical drops formulated for natural everyday comfort, restorative joint care, and effortless daily movement."
          }
        },
        {
          "type": "link_column",
          "settings": {
            "heading": "Quick Links"
          }
        },
        {
          "type": "link_column",
          "settings": {
            "heading": "Customer Care"
          }
        },
        {
          "type": "contact_column",
          "settings": {
            "heading": "Contact Us",
            "email": "hello@tierabotanicals.com",
            "hours": "Mon – Fri: 9:00 AM – 6:00 PM",
            "delivery_badge": "Direct Tracked Express Delivery",
            "eco_badge": "100% Eco-Sustainable Packaging"
          }
        }
      ]
    }
  ]
}
{% endschema %}
