{{ 'horizon-botanical.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} footer.hb-footer {
    background-color: {{ section.settings.background_color | default: '#15331e' }};
    color: {{ section.settings.text_color | default: '#d1e2d4' }};
    padding-top: {{ section.settings.padding_top | default: 64 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;
    {% if section.settings.border_top_width > 0 %}
      border-top: {{ section.settings.border_top_width }}px solid {{ section.settings.border_top_color | default: '#204b2e' }};
    {% else %}
      border-top: none;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .hb-footer-col h4 {
    color: {{ section.settings.heading_color | default: '#ffffff' }};
    font-size: {{ section.settings.heading_size | default: 16 }}px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 20px;
  }

  #shopify-section-{{ section.id }} .hb-footer-about {
    color: {{ section.settings.text_color | default: '#d1e2d4' }};
    font-size: {{ section.settings.text_size | default: 14 }}px;
    line-height: 1.65;
    margin-bottom: 20px;
  }

  #shopify-section-{{ section.id }} .hb-footer-links li {
    color: {{ section.settings.text_color | default: '#d1e2d4' }};
    font-size: {{ section.settings.link_size | default: 14 }}px;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .hb-footer-links a {
    color: {{ section.settings.link_color | default: '#d1e2d4' }};
    font-size: {{ section.settings.link_size | default: 14 }}px;
    text-decoration: none;
    transition: color 0.25s ease, transform 0.25s ease;
  }

  #shopify-section-{{ section.id }} .hb-footer-links a:hover {
    color: {{ section.settings.link_hover_color | default: '#68d391' }};
    transform: translateX(3px);
  }

  /* Social Media Handles */
  #shopify-section-{{ section.id }} .hb-footer-social {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 16px;
  }

  #shopify-section-{{ section.id }} .hb-footer-social-link {
    width: {{ section.settings.social_icon_size | default: 36 }}px;
    height: {{ section.settings.social_icon_size | default: 36 }}px;
    border-radius: {{ section.settings.social_icon_radius | default: 50 }}%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: {{ section.settings.social_icon_bg | default: '#204b2e' }};
    color: {{ section.settings.social_icon_color | default: '#d1e2d4' }};
    border: 1px solid {{ section.settings.social_icon_border | default: '#295c39' }};
    transition: all 0.25s ease;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .hb-footer-social-link:hover {
    background-color: {{ section.settings.social_icon_hover_bg | default: '#257942' }};
    color: {{ section.settings.social_icon_hover_color | default: '#ffffff' }};
    border-color: {{ section.settings.social_icon_hover_bg | default: '#257942' }};
    transform: translateY(-2px);
  }

  #shopify-section-{{ section.id }} .hb-footer-social-link svg {
    width: 17px;
    height: 17px;
  }

  #shopify-section-{{ section.id }} .hb-footer-bottom {
    border-top: 1px solid {{ section.settings.bottom_bar_border_color | default: '#204b2e' }};
    color: {{ section.settings.copyright_color | default: '#a3bfa8' }};
    font-size: {{ section.settings.copyright_size | default: 13 }}px;
  }

  /* Mobile View Responsive Styling */
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} footer.hb-footer {
      padding-top: {{ section.settings.mobile_padding_top | default: 48 }}px !important;
      padding-bottom: {{ section.settings.mobile_padding_bottom | default: 32 }}px !important;
    }

    #shopify-section-{{ section.id }} .hb-footer-grid {
      {% if section.settings.mobile_columns == '2' %}
        grid-template-columns: repeat(2, 1fr) !important;
      {% else %}
        grid-template-columns: 1fr !important;
      {% endif %}
      gap: {{ section.settings.mobile_col_gap | default: 28 }}px !important;
      margin-bottom: 32px !important;
    }

    {% if section.settings.mobile_columns == '2' %}
      #shopify-section-{{ section.id }} .hb-footer-col:first-child {
        grid-column: 1 / -1 !important;
      }
    {% endif %}

    {% if section.settings.show_mobile_dividers %}
      #shopify-section-{{ section.id }} .hb-footer-col:not(:last-child) {
        border-bottom: 1px solid {{ section.settings.mobile_divider_color | default: 'rgba(255, 255, 255, 0.12)' }} !important;
        padding-bottom: {{ section.settings.mobile_col_gap | default: 28 }}px !important;
      }
    {% endif %}

    #shopify-section-{{ section.id }} .hb-footer-links {
      gap: {{ section.settings.mobile_link_spacing | default: 12 }}px !important;
    }

    /* Mobile Content Alignment */
    {% if section.settings.mobile_alignment == 'center' %}
      #shopify-section-{{ section.id }} .hb-footer-col {
        text-align: center !important;
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: flex-start !important;
      }

      #shopify-section-{{ section.id }} .hb-footer-brand {
        display: flex !important;
        justify-content: center !important;
        width: 100% !important;
      }

      #shopify-section-{{ section.id }} .hb-footer-brand img,
      #shopify-section-{{ section.id }} .hb-footer-brand svg {
        margin-left: auto !important;
        margin-right: auto !important;
        display: block !important;
      }

      #shopify-section-{{ section.id }} .hb-footer-about {
        text-align: center !important;
        margin-left: auto !important;
        margin-right: auto !important;
        max-width: 480px !important;
      }

      #shopify-section-{{ section.id }} .hb-footer-col h4 {
        text-align: center !important;
        width: 100% !important;
        margin-bottom: 16px !important;
      }

      #shopify-section-{{ section.id }} .hb-footer-links {
        align-items: center !important;
        text-align: center !important;
        width: 100% !important;
        padding: 0 !important;
      }

      #shopify-section-{{ section.id }} .hb-footer-links li {
        text-align: center !important;
        width: 100% !important;
        display: block !important;
      }

      #shopify-section-{{ section.id }} .hb-footer-links a {
        text-align: center !important;
        display: inline-block !important;
      }

      #shopify-section-{{ section.id }} .hb-footer-links a:hover {
        transform: scale(1.04) !important;
      }

      #shopify-section-{{ section.id }} .hb-footer-social {
        justify-content: center !important;
        width: 100% !important;
        margin-left: auto !important;
        margin-right: auto !important;
      }
    {% else %}
      #shopify-section-{{ section.id }} .hb-footer-col {
        text-align: left !important;
        align-items: flex-start !important;
      }

      #shopify-section-{{ section.id }} .hb-footer-brand {
        display: flex !important;
        justify-content: flex-start !important;
      }

      #shopify-section-{{ section.id }} .hb-footer-brand img,
      #shopify-section-{{ section.id }} .hb-footer-brand svg {
        margin-left: 0 !important;
        margin-right: auto !important;
      }

      #shopify-section-{{ section.id }} .hb-footer-about {
        text-align: left !important;
        margin-left: 0 !important;
      }

      #shopify-section-{{ section.id }} .hb-footer-links {
        align-items: flex-start !important;
        text-align: left !important;
      }

      #shopify-section-{{ section.id }} .hb-footer-social {
        justify-content: flex-start !important;
      }
    {% endif %}

    /* Specific Mobile Logo Alignment overrides */
    {% if section.settings.mobile_logo_alignment == 'center' %}
      #shopify-section-{{ section.id }} .hb-footer-brand {
        justify-content: center !important;
      }
      #shopify-section-{{ section.id }} .hb-footer-brand img,
      #shopify-section-{{ section.id }} .hb-footer-brand svg {
        margin-left: auto !important;
        margin-right: auto !important;
      }
    {% elsif section.settings.mobile_logo_alignment == 'left' %}
      #shopify-section-{{ section.id }} .hb-footer-brand {
        justify-content: flex-start !important;
      }
      #shopify-section-{{ section.id }} .hb-footer-brand img,
      #shopify-section-{{ section.id }} .hb-footer-brand svg {
        margin-left: 0 !important;
        margin-right: auto !important;
      }
    {% endif %}

    /* Mobile Brand Logo Width */
    #shopify-section-{{ section.id }} .hb-footer-brand img,
    #shopify-section-{{ section.id }} .hb-footer-brand svg {
      width: {{ section.settings.mobile_logo_width | default: 150 }}px !important;
      max-width: 100% !important;
      height: auto !important;
    }

    /* Mobile Bottom Bar Alignment */
    #shopify-section-{{ section.id }} .hb-footer-bottom {
      flex-direction: column !important;
      gap: 16px !important;
      padding-top: 24px !important;
      {% case section.settings.mobile_bottom_alignment %}
        {% when 'left' %}
          text-align: left !important;
          align-items: flex-start !important;
        {% when 'center' %}
          text-align: center !important;
          align-items: center !important;
        {% else %}
          text-align: center !important;
          align-items: center !important;
      {% endcase %}
    }

    #shopify-section-{{ section.id }} .hb-payment-badges {
      justify-content: center !important;
      width: 100% !important;
    }
  }
{%- endstyle -%}

{%- capture social_icons -%}
  {%- if section.settings.social_instagram != blank or section.settings.social_facebook != blank or section.settings.social_tiktok != blank or section.settings.social_youtube != blank or section.settings.social_x != blank or section.settings.social_whatsapp != blank or section.settings.social_pinterest != blank -%}
    <div class="hb-footer-social">
      {%- if section.settings.social_instagram != blank -%}
        <a href="{{ section.settings.social_instagram }}" class="hb-footer-social-link" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </a>
      {%- endif -%}
      {%- if section.settings.social_facebook != blank -%}
        <a href="{{ section.settings.social_facebook }}" class="hb-footer-social-link" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
        </a>
      {%- endif -%}
      {%- if section.settings.social_tiktok != blank -%}
        <a href="{{ section.settings.social_tiktok }}" class="hb-footer-social-link" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.82 4.48 6.29 6.29 0 0 0 1.87-4.47V8.71a8.21 8.21 0 0 0 4.9 1.59v-3.41a4.83 4.83 0 0 1-1-.2z"/></svg>
        </a>
      {%- endif -%}
      {%- if section.settings.social_whatsapp != blank -%}
        {%- assign wa_url = section.settings.social_whatsapp -%}
        {%- unless wa_url contains 'http' or wa_url contains 'wa.me' -%}
          {%- assign wa_url = 'https://wa.me/' | append: wa_url -%}
        {%- endunless -%}
        <a href="{{ wa_url }}" class="hb-footer-social-link" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
        </a>
      {%- endif -%}
      {%- if section.settings.social_youtube != blank -%}
        <a href="{{ section.settings.social_youtube }}" class="hb-footer-social-link" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
      {%- endif -%}
      {%- if section.settings.social_x != blank -%}
        <a href="{{ section.settings.social_x }}" class="hb-footer-social-link" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
      {%- endif -%}
      {%- if section.settings.social_pinterest != blank -%}
        <a href="{{ section.settings.social_pinterest }}" class="hb-footer-social-link" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0a12 12 0 0 0-4.37 23.17c-.07-.9-.13-2.28.03-3.26l1.24-5.26s-.31-.63-.31-1.56c0-1.46.85-2.55 1.9-2.55.9 0 1.33.67 1.33 1.48 0 .9-.58 2.26-.87 3.51-.25 1.05.53 1.9 1.56 1.9 1.88 0 3.32-1.98 3.32-4.84 0-2.53-1.82-4.3-4.42-4.3-3.01 0-4.78 2.26-4.78 4.59 0 .91.35 1.88.79 2.41a.32.32 0 0 1 .07.31c-.08.35-.27 1.1-.31 1.25-.05.21-.17.26-.39.16-1.45-.67-2.36-2.79-2.36-4.49 0-3.66 2.66-7.02 7.67-7.02 4.03 0 7.16 2.87 7.16 6.7 0 4-2.52 7.23-6.02 7.23-1.18 0-2.28-.61-2.66-1.33l-.72 2.76c-.26 1-.97 2.26-1.45 3.03A12 12 0 1 0 12 0z"/></svg>
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

<footer class="hb-footer">
  <div class="hb-container">
    <div class="hb-footer-grid">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'brand_info' %}
            <div class="hb-footer-col" {{ block.shopify_attributes }}>
              <div class="hb-footer-brand">
                {% if block.settings.logo != blank %}
                  {%- assign brand_logo_w = block.settings.logo_width | default: 150 -%}
                  {%- capture brand_style -%}width: {{ brand_logo_w }}px; max-width: 100%; height: auto;{%- endcapture -%}
                  {{ block.settings.logo | image_url: width: 500 | image_tag: loading: 'lazy', alt: shop.name, style: brand_style }}
                {% else %}
                  <img src="{{ 'horizon-logo.svg' | asset_url }}" alt="{{ shop.name }}" style="width: {{ block.settings.logo_width | default: 150 }}px; max-width: 100%; height: auto;" width="{{ block.settings.logo_width | default: 150 }}" height="38">
                {% endif %}
              </div>
              {% if block.settings.about_text != blank %}
                <p class="hb-footer-about" style="{% if block.settings.custom_text_color != blank %}color: {{ block.settings.custom_text_color }};{% endif %}">{{ block.settings.about_text }}</p>
              {% endif %}
              {% if section.settings.show_social_in_brand %}
                {{ social_icons }}
              {% endif %}
            </div>

          {% when 'link_column' %}
            {%- assign blk_heading_col = block.settings.custom_heading_color | default: section.settings.heading_color | default: '#ffffff' -%}
            {%- assign blk_link_col = block.settings.custom_link_color | default: section.settings.link_color | default: '#d1e2d4' -%}

            <div class="hb-footer-col" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h4 style="color: {{ blk_heading_col }};">{{ block.settings.heading }}</h4>
              {% endif %}
              <ul class="hb-footer-links">
                {% if block.settings.menu != blank and linklists[block.settings.menu].links.size > 0 %}
                  {% for link in linklists[block.settings.menu].links %}
                    <li><a href="{{ link.url }}" style="color: {{ blk_link_col }};">{{ link.title }}</a></li>
                  {% endfor %}
                {% else %}
                  {% if block.settings.heading contains 'Customer' or block.settings.heading contains 'Care' %}
                    <li><a href="/pages/shipping" style="color: {{ blk_link_col }};">Shipping Policy</a></li>
                    <li><a href="/pages/refunds" style="color: {{ blk_link_col }};">Refund & Return Policy</a></li>
                    <li><a href="/pages/privacy" style="color: {{ blk_link_col }};">Privacy Policy</a></li>
                    <li><a href="/pages/terms" style="color: {{ blk_link_col }};">Terms of Service</a></li>
                    <li><a href="#faq" style="color: {{ blk_link_col }};">Support Center</a></li>
                  {% else %}
                    <li><a href="/" style="color: {{ blk_link_col }};">Home</a></li>
                    <li><a href="/collections/all" style="color: {{ blk_link_col }};">All Products</a></li>
                    <li><a href="#ingredients" style="color: {{ blk_link_col }};">Our Ingredients</a></li>
                    <li><a href="#faq" style="color: {{ blk_link_col }};">Frequently Asked</a></li>
                    <li><a href="/pages/track-order" style="color: {{ blk_link_col }};">Track My Order</a></li>
                  {% endif %}
                {% endif %}
              </ul>
            </div>

          {% when 'contact_column' %}
            {%- assign blk_cnt_heading = block.settings.custom_heading_color | default: section.settings.heading_color | default: '#ffffff' -%}
            <div class="hb-footer-col" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h4 style="color: {{ blk_cnt_heading }};">{{ block.settings.heading }}</h4>
              {% endif %}
              <ul class="hb-footer-links">
                {% if block.settings.email != blank %}
                  <li><a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a></li>
                {% endif %}
                {% if block.settings.phone != blank %}
                  <li><a href="tel:{{ block.settings.phone }}">{{ block.settings.phone }}</a></li>
                {% endif %}
                {% if block.settings.hours != blank %}
                  <li>{{ block.settings.hours }}</li>
                {% endif %}
                {% if block.settings.delivery_badge != blank %}
                  <li>{{ block.settings.delivery_badge }}</li>
                {% endif %}
                {% if block.settings.eco_badge != blank %}
                  <li>{{ block.settings.eco_badge }}</li>
                {% endif %}
              </ul>
              {% if block.settings.show_social_here %}
                {{ social_icons }}
              {% endif %}
            </div>

          {% when 'social_column' %}
            <div class="hb-footer-col" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h4>{{ block.settings.heading }}</h4>
              {% endif %}
              {% if block.settings.text != blank %}
                <p class="hb-footer-about" style="margin-bottom: 14px;">{{ block.settings.text }}</p>
              {% endif %}
              {{ social_icons }}
            </div>
        {% endcase %}
      {% endfor %}
    </div>

    <div class="hb-footer-bottom">
      <div>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_text }}</div>
      
      {% if section.settings.show_social_in_bottom %}
        <div>
          {{ social_icons }}
        </div>
      {% endif %}

      {% if section.settings.show_payment_icons %}
        <div class="hb-payment-badges">
          <svg width="38" height="24" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="3" fill="#ffffff" stroke="#e0e0e0"/><path d="M15 17L17 7H20L18 17H15Z" fill="#1434CB"/><path d="M25 7.2C24.3 7 23.3 6.8 22.1 6.8C19.3 6.8 17.3 8.3 17.3 10.4C17.3 12 18.7 12.8 19.8 13.3C20.9 13.8 21.3 14.2 21.3 14.7C21.3 15.5 20.3 15.9 19.4 15.9C18.1 15.9 17.3 15.6 16.5 15.2L16.1 15L15.7 17.2C16.4 17.5 17.7 17.8 19.1 17.8C22.1 17.8 24 16.3 24 14.1C24 12.8 23.2 11.8 21.5 11C20.5 10.5 19.9 10.2 19.9 9.6C19.9 9.1 20.5 8.6 21.7 8.6C22.6 8.6 23.4 8.8 23.9 9.1L24.2 9.2L25 7.2Z" fill="#1434CB"/></svg>
          <svg width="38" height="24" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="3" fill="#ffffff" stroke="#e0e0e0"/><circle cx="15" cy="12" r="7" fill="#EB001B"/><circle cx="23" cy="12" r="7" fill="#F79E1B" fill-opacity="0.8"/></svg>
          {% if section.settings.show_cod_badge %}
            <svg width="38" height="24" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="3" fill="#ffffff" stroke="#e0e0e0"/><rect x="6" y="8" width="26" height="8" rx="2" fill="#257942"/><text x="19" y="14" font-size="6" font-weight="700" fill="#ffffff" text-anchor="middle" font-family="sans-serif">COD</text></svg>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Botanical Footer",
  "settings": [
    {
      "type": "header",
      "content": "Footer Background & Borders"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#15331e"
    },
    {
      "type": "range",
      "id": "border_top_width",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "label": "Top Divider Border Width",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_top_color",
      "label": "Top Divider Border Color",
      "default": "#204b2e"
    },
    {
      "type": "header",
      "content": "Mobile View Styling & Alignment"
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "label": "Mobile Content Alignment",
      "options": [
        {
          "value": "center",
          "label": "Center (Centered Logo, Text, Links & Icons)"
        },
        {
          "value": "left",
