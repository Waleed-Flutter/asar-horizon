<footer id="hb-footer-{{ section.id }}" class="hb-footer" style="
  {% liquid
    assign f_bg = section.settings.background_color | default: '#15331e'
    if f_bg contains 'settings.' or f_bg contains '{{'
      assign f_bg = 'var(--color-background, #15331e)'
    endif
    assign f_tc = section.settings.text_color | default: '#f2f7f3'
    if f_tc contains 'settings.' or f_tc contains '{{'
      assign f_tc = 'var(--color-foreground, #f2f7f3)'
    endif
    assign h_col = section.settings.headings_color | default: '#ffffff'
    assign l_col = section.settings.links_color | default: '#d1d5db'
    assign l_hov = section.settings.links_hover_color | default: '#ffffff'
    assign div_col = section.settings.bottom_border_color | default: 'rgba(255,255,255,0.12)'
  %}
  --hb-footer-link: {{ l_col }};
  --hb-footer-link-hover: {{ l_hov }};
  background-color: {{ f_bg }};
  color: {{ f_tc }};
  padding-top: {{ section.settings.padding_top | default: 64 }}px;
  padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;
">
  <div class="hb-container">
    <div class="hb-footer-grid">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'brand_info' %}
            <div class="hb-footer-col" {{ block.shopify_attributes }}>
              <div class="hb-footer-brand">
                {% assign footer_logo = block.settings.logo | default: settings.logo %}
                {% if footer_logo != blank %}
                  {{ footer_logo | image_url: width: 300 | image_tag: loading: 'lazy', alt: shop.name, style: 'max-width: 100%; height: auto;' }}
                {% else %}
                  <img src="{{ 'horizon-logo.svg' | asset_url }}" alt="{{ shop.name }}" width="{{ block.settings.logo_width | default: 150 }}" height="38">
                {% endif %}
              </div>
              {% if block.settings.about_text != blank %}
                <p class="hb-footer-about" style="color: {{ f_tc }};">{{ block.settings.about_text }}</p>
              {% endif %}
            </div>

          {% when 'link_column' %}
            <div class="hb-footer-col" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h4 style="color: {{ h_col }};">{{ block.settings.heading }}</h4>
              {% endif %}
              <ul class="hb-footer-links">
                {% if block.settings.menu != blank and linklists[block.settings.menu].links.size > 0 %}
                  {% for link in linklists[block.settings.menu].links %}
                    <li><a href="{{ link.url }}" style="color: var(--hb-footer-link);">{{ link.title }}</a></li>
                  {% endfor %}
                {% else %}
                  {% if block.settings.heading contains 'Customer' or block.settings.heading contains 'Care' or block.settings.heading contains 'Policies' %}
                    <li><a href="/pages/shipping" style="color: var(--hb-footer-link);">Shipping Policy</a></li>
                    <li><a href="/pages/refunds" style="color: var(--hb-footer-link);">Refund & Return Policy</a></li>
                    <li><a href="/pages/privacy" style="color: var(--hb-footer-link);">Privacy Policy</a></li>
                    <li><a href="/pages/terms" style="color: var(--hb-footer-link);">Terms of Service</a></li>
                    <li><a href="#faq" style="color: var(--hb-footer-link);">Support Center</a></li>
                  {% else %}
                    <li><a href="/" style="color: var(--hb-footer-link);">Home</a></li>
                    <li><a href="/collections/all" style="color: var(--hb-footer-link);">All Products</a></li>
                    <li><a href="#ingredients" style="color: var(--hb-footer-link);">Our Ingredients</a></li>
                    <li><a href="#faq" style="color: var(--hb-footer-link);">Frequently Asked</a></li>
                    <li><a href="/pages/track-order" style="color: var(--hb-footer-link);">Track My Order</a></li>
                  {% endif %}
                {% endif %}
              </ul>
            </div>

          {% when 'contact_column' %}
            <div class="hb-footer-col" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h4 style="color: {{ h_col }};">{{ block.settings.heading }}</h4>
              {% endif %}
              <ul class="hb-footer-links">
                {% if block.settings.email != blank %}
                  <li><a href="mailto:{{ block.settings.email }}" style="color: var(--hb-footer-link);">{{ block.settings.email }}</a></li>
                {% endif %}
                {% if block.settings.hours != blank %}
                  <li style="color: {{ f_tc }};">{{ block.settings.hours }}</li>
                {% endif %}
                {% if block.settings.delivery_badge != blank %}
                  <li style="color: {{ f_tc }};">{{ block.settings.delivery_badge }}</li>
                {% endif %}
                {% if block.settings.eco_badge != blank %}
                  <li style="color: {{ f_tc }};">{{ block.settings.eco_badge }}</li>
                {% endif %}
              </ul>
            </div>
        {% endcase %}
      {% endfor %}
    </div>

    <div class="hb-footer-bottom" style="border-top: 1px solid {{ div_col }};">
      <div style="color: {{ f_tc }};">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_text }}</div>
      {% if section.settings.show_payment_icons %}
        <div class="hb-payment-badges">
          <svg width="38" height="24" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="3" fill="#ffffff" stroke="#e0e0e0"/><path d="M15 17L17 7H20L18 17H15Z" fill="#1434CB"/><path d="M25 7.2C24.3 7 23.3 6.8 22.1 6.8C19.3 6.8 17.3 8.3 17.3 10.4C17.3 12 18.7 12.8 19.8 13.3C20.9 13.8 21.3 14.2 21.3 14.7C21.3 15.5 20.3 15.9 19.4 15.9C18.1 15.9 17.3 15.6 16.5 15.2L16.1 15L15.7 17.2C16.4 17.5 17.7 17.8 19.1 17.8C22.1 17.8 24 16.3 24 14.1C24 12.8 23.2 11.8 21.5 11C20.5 10.5 19.9 10.2 19.9 9.6C19.9 9.1 20.5 8.6 21.7 8.6C22.6 8.6 23.4 8.8 23.9 9.1L24.2 9.2L25 7.2Z" fill="#1434CB"/></svg>
          <svg width="38" height="24" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="3" fill="#ffffff" stroke="#e0e0e0"/><circle cx="15" cy="12" r="7" fill="#EB001B"/><circle cx="23" cy="12" r="7" fill="#F79E1B" fill-opacity="0.8"/></svg>
          {% if section.settings.show_cod_badge %}
            <svg width="38" height="24" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="3" fill="#ffffff" stroke="#e0e0e0"/><rect x="6" y="8" width="26" height="8" rx="2" fill="#257942"/><text x="19" y="14" font-size="6" font-weight="700" fill="#ffffff" text-anchor="middle" font-family="sans-serif">COD</text></svg>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Botanical Footer",
  "settings": [
    {
      "type": "header",
      "content": "Footer Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#15331e"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body / Description Text Color",
      "default": "#f2f7f3"
    },
    {
      "type": "color",
      "id": "headings_color",
      "label": "Column Headings Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "links_color",
      "label": "Links Color",
      "default": "#d1d5db"
    },
    {
      "type": "color",
      "id": "links_hover_color",
      "label": "Links Hover Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bottom_border_color",
      "label": "Divider Border Color",
      "default": "rgba(255,255,255,0.12)"
    },
    {
      "type": "header",
      "content": "Payment Badges & Copyright"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show Payment Icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cod_badge",
      "label": "Show Cash on Delivery (COD) Badge",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "All rights reserved. Powered by Shopify Horizon."
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "brand_info",
      "name": "Brand Column",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Custom Footer Logo"
        },
        {
          "type": "range",
          "id": "logo_width",
          "min": 80,
          "max": 240,
          "step": 10,
          "unit": "px",
          "label": "Logo Width",
          "default": 150
        },
        {
          "type": "textarea",
          "id": "about_text",
          "label": "About Text",
          "default": "Pure, plant-powered botanical drops formulated for natural everyday comfort, restorative joint care, and effortless daily movement."
        }
      ]
    },
    {
      "type": "link_column",
      "name": "Menu Links Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column Heading",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Navigation Menu"
        }
      ]
    },
    {
      "type": "contact_column",
      "name": "Contact / Badges",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column Heading",
          "default": "Contact Us"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Support Email",
          "default": "hello@tierabotanicals.com"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Business Hours",
          "default": "Mon – Fri: 9:00 AM – 6:00 PM"
        },
        {
          "type": "text",
          "id": "delivery_badge",
          "label": "Shipping Badge Note",
          "default": "Direct Tracked Express Delivery"
        },
        {
          "type": "text",
          "id": "eco_badge",
          "label": "Sustainability Badge Note",
          "default": "100% Eco-Sustainable Packaging"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Botanical Footer"
    }
  ]
}
{% endschema %}
