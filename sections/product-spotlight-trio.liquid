<section id="hb-spotlight-{{ section.id }}" class="hb-spotlight-section" style="
  {% liquid
    assign bg = section.settings.bg_color | default: '#ffffff'
    if bg contains 'settings.' or bg contains '{{'
      assign bg = 'var(--color-background, #ffffff)'
    endif
    assign h_col = section.settings.heading_color | default: '#111827'
    assign t_col = section.settings.text_color | default: '#4b5563'
    assign eye_col = section.settings.eyebrow_color | default: '#257942'
    assign p_btn_bg = section.settings.primary_btn_bg | default: '#257942'
    assign p_btn_col = section.settings.primary_btn_color | default: '#ffffff'
    assign p_btn_rad = section.settings.primary_btn_radius | default: 30
    assign s_btn_col = section.settings.secondary_btn_color | default: '#111827'
    assign b_card_bg = section.settings.badge_card_bg | default: '#ffffff'
    assign b_title_col = section.settings.badge_title_color | default: '#111827'
    assign b_desc_col = section.settings.badge_desc_color | default: '#6b7280'
    assign b_icon_col = section.settings.badge_icon_color | default: '#257942'
  %}
  background-color: {{ bg }};
  padding-top: {{ section.settings.padding_top | default: 88 }}px;
  padding-bottom: {{ section.settings.padding_bottom | default: 88 }}px;
">
  <div class="hb-container">
    <div class="hb-spotlight-grid">
      <div class="hb-spotlight-visual">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="440" height="440" loading="lazy">
        {% else %}
          <img src="{{ 'bottles-trio-showcase.jpg' | asset_url }}" alt="Triple Bottle Product Lineup" width="440" height="440" loading="lazy">
        {% endif %}
      </div>

      <div class="hb-spotlight-content">
        {% if section.settings.eyebrow != blank %}
          <span class="hb-eyebrow" style="color: {{ eye_col }};">{{ section.settings.eyebrow }}</span>
        {% endif %}
        <h2 style="color: {{ h_col }};">{{ section.settings.heading }}</h2>
        <div class="hb-hero-desc" style="color: {{ t_col }};">
          {{ section.settings.description }}
        </div>

        <!-- 4 Key Feature Grid -->
        <div class="hb-spotlight-features">
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              <div class="hb-spotlight-feature" {{ block.shopify_attributes }} style="background-color: {{ b_card_bg }}; border-radius: {{ section.settings.badge_card_radius | default: 12 }}px;">
                <div class="hb-spotlight-icon" style="color: {{ b_icon_col }};">
                  {% case block.settings.icon %}
                    {% when 'shield' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    {% when 'bolt' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                    {% when 'target' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                    {% when 'droplet' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
                    {% when 'star' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    {% else %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                  {% endcase %}
                </div>
                <div>
                  <h4 style="color: {{ b_title_col }};">{{ block.settings.title }}</h4>
                  <span style="color: {{ b_desc_col }};">{{ block.settings.subtitle }}</span>
                </div>
              </div>
            {% endfor %}
          {% else %}
            <!-- Defaults -->
            <div class="hb-spotlight-feature" style="background-color: {{ b_card_bg }}; border-radius: {{ section.settings.badge_card_radius | default: 12 }}px;">
              <div class="hb-spotlight-icon" style="color: {{ b_icon_col }};"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
              <div><h4 style="color: {{ b_title_col }};">Non-Toxic</h4><span style="color: {{ b_desc_col }};">Pure natural extracts</span></div>
            </div>
            <div class="hb-spotlight-feature" style="background-color: {{ b_card_bg }}; border-radius: {{ section.settings.badge_card_radius | default: 12 }}px;">
              <div class="hb-spotlight-icon" style="color: {{ b_icon_col }};"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></div>
              <div><h4 style="color: {{ b_title_col }};">Fast Absorbing</h4><span style="color: {{ b_desc_col }};">Sub-minute transdermal delivery</span></div>
            </div>
            <div class="hb-spotlight-feature" style="background-color: {{ b_card_bg }}; border-radius: {{ section.settings.badge_card_radius | default: 12 }}px;">
              <div class="hb-spotlight-icon" style="color: {{ b_icon_col }};"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg></div>
              <div><h4 style="color: {{ b_title_col }};">Targeted Relief</h4><span style="color: {{ b_desc_col }};">Calms joint & muscle tension</span></div>
            </div>
            <div class="hb-spotlight-feature" style="background-color: {{ b_card_bg }}; border-radius: {{ section.settings.badge_card_radius | default: 12 }}px;">
              <div class="hb-spotlight-icon" style="color: {{ b_icon_col }};"><circle cx="12" cy="7" r="4"/></svg></div>
              <div><h4 style="color: {{ b_title_col }};">Clean Formula</h4><span style="color: {{ b_desc_col }};">Zero mineral oils or parabens</span></div>
            </div>
          {% endif %}
        </div>

        <div class="hb-hero-actions">
          {% if section.settings.primary_cta_text != blank %}
            <a href="{{ section.settings.primary_cta_link | default: '/collections/all' }}" class="hb-btn-primary" style="
              background-color: {{ p_btn_bg }} !important;
              color: {{ p_btn_col }} !important;
              border-radius: {{ p_btn_rad }}px !important;
            ">
              {{ section.settings.primary_cta_text }}
            </a>
          {% endif %}
          {% if section.settings.secondary_cta_text != blank %}
            <a href="{{ section.settings.secondary_cta_link | default: '#ingredients' }}" class="hb-btn-link" style="color: {{ s_btn_col }} !important;">
              {{ section.settings.secondary_cta_text }} &rarr;
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Spotlight Trio",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Showcase Image (Trio Bottles)"
    },
    {
      "type": "header",
      "content": "Headings & Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "DAILY RELIEF BLENDS"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#257942"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Botanical Care for Everyday Movement"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111827"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description Copy",
      "default": "<p>Targeted botanical formulas designed to calm tension and restore flexibility naturally without greasy residue or harsh synthetic ingredients.</p>"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description Text Color",
      "default": "#4b5563"
    },
    {
      "type": "header",
      "content": "Action Buttons"
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary Button Label",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary Button URL"
    },
    {
      "type": "color",
      "id": "primary_btn_bg",
      "label": "Primary Button Background",
      "default": "#257942"
    },
    {
      "type": "color",
      "id": "primary_btn_color",
      "label": "Primary Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "primary_btn_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Primary Button Border Radius",
      "default": 30
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary Button Label",
      "default": "See Ingredients"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary Button URL"
    },
    {
      "type": "color",
      "id": "secondary_btn_color",
      "label": "Secondary Button Text Color",
      "default": "#111827"
    },
    {
      "type": "header",
      "content": "Feature Badges Styling"
    },
    {
      "type": "color",
      "id": "badge_card_bg",
      "label": "Badge Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "badge_card_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Badge Border Radius",
      "default": 12
    },
    {
      "type": "color",
      "id": "badge_icon_color",
      "label": "Badge Icon Color",
      "default": "#257942"
    },
    {
      "type": "color",
      "id": "badge_title_color",
      "label": "Badge Title Color",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "badge_desc_color",
      "label": "Badge Description Color",
      "default": "#6b7280"
    },
    {
      "type": "header",
      "content": "Section Layout & Padding"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield / Clean" },
            { "value": "bolt", "label": "Lightning / Fast Absorbing" },
            { "value": "target", "label": "Target / Relief" },
            { "value": "check", "label": "Checkmark / Tested" },
            { "value": "droplet", "label": "Droplet / Pure" },
            { "value": "star", "label": "Star / Premium" }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "Non-Toxic"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Feature Subtitle",
          "default": "100% clean botanical extracts"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Spotlight Trio",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "shield",
            "title": "Non-Toxic",
            "subtitle": "Pure natural extracts"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "bolt",
            "title": "Fast Absorbing",
            "subtitle": "Sub-minute transdermal delivery"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "target",
            "title": "Targeted Relief",
            "subtitle": "Calms joint & muscle tension"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "check",
            "title": "Clean Formula",
            "subtitle": "Zero mineral oils or parabens"
          }
        }
      ]
    }
  ]
}
{% endschema %}
