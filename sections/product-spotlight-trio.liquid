{{ 'horizon-botanical.css' | asset_url | stylesheet_tag }}

{% liquid
  assign primary_btn_bg = section.settings.primary_btn_bg | default: '#7a2a2b'
  assign primary_btn_color = section.settings.primary_btn_color | default: '#ffffff'
  assign primary_btn_border = section.settings.primary_btn_border_color | default: primary_btn_bg
  assign primary_btn_hover_bg = section.settings.primary_btn_hover_bg | default: '#5c1f20'
  assign primary_btn_hover_color = section.settings.primary_btn_hover_color | default: '#ffffff'
  assign primary_btn_radius = section.settings.primary_btn_radius | default: 30

  assign secondary_btn_color = section.settings.secondary_btn_color | default: primary_btn_bg
  assign secondary_btn_bg = section.settings.secondary_btn_bg | default: 'transparent'
  assign secondary_btn_border = section.settings.secondary_btn_border_color | default: 'transparent'
  assign secondary_btn_hover_color = section.settings.secondary_btn_hover_color | default: '#5c1f20'
  assign secondary_btn_hover_bg = section.settings.secondary_btn_hover_bg | default: 'transparent'
  assign secondary_btn_radius = section.settings.secondary_btn_radius | default: 30

  assign icon_color = section.settings.feature_icon_color | default: primary_btn_bg
  assign icon_bg = section.settings.feature_icon_bg | default: '#fee6d4'
  assign feature_title_col = section.settings.feature_title_color | default: '#111827'
  assign feature_subtitle_col = section.settings.feature_subtitle_color | default: '#6b7280'

  assign eyebrow_col = section.settings.eyebrow_color | default: primary_btn_bg
  assign heading_col = section.settings.heading_color | default: '#111827'
  assign desc_col = section.settings.desc_color | default: '#4b5563'
  assign image_rad = section.settings.image_radius | default: 16
%}

<style>
  #shopify-section-{{ section.id }} .hb-spotlight-section {
    padding-top: {{ section.settings.padding_top | default: 88 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 88 }}px;
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
  }
  #shopify-section-{{ section.id }} .hb-spotlight-content .hb-eyebrow {
    color: {{ eyebrow_col }} !important;
    {% if section.settings.eyebrow_size != blank %}
      font-size: {{ section.settings.eyebrow_size }}px !important;
    {% endif %}
  }
  #shopify-section-{{ section.id }} .hb-spotlight-content h2 {
    color: {{ heading_col }} !important;
    {% if section.settings.heading_size != blank %}
      font-size: {{ section.settings.heading_size }}px !important;
    {% endif %}
  }
  #shopify-section-{{ section.id }} .hb-spotlight-desc,
  #shopify-section-{{ section.id }} .hb-spotlight-desc p {
    color: {{ desc_col }} !important;
    {% if section.settings.desc_size != blank %}
      font-size: {{ section.settings.desc_size }}px !important;
    {% endif %}
  }
  #shopify-section-{{ section.id }} .hb-spotlight-visual img {
    border-radius: {{ image_rad }}px !important;
    {% unless section.settings.image_shadow %}
      box-shadow: none !important;
    {% endunless %}
  }

  /* Feature Grid Icons & Text */
  #shopify-section-{{ section.id }} .hb-spotlight-icon {
    background-color: {{ icon_bg }} !important;
    color: {{ icon_color }} !important;
  }
  #shopify-section-{{ section.id }} .hb-spotlight-feature h4 {
    color: {{ feature_title_col }} !important;
  }
  #shopify-section-{{ section.id }} .hb-spotlight-feature span {
    color: {{ feature_subtitle_col }} !important;
  }

  /* Primary Button */
  #shopify-section-{{ section.id }} .hb-spotlight-btn-primary {
    background-color: {{ primary_btn_bg }} !important;
    color: {{ primary_btn_color }} !important;
    border: 1px solid {{ primary_btn_border }} !important;
    border-radius: {{ primary_btn_radius }}px !important;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12) !important;
    transition: all 0.25s ease;
  }
  #shopify-section-{{ section.id }} .hb-spotlight-btn-primary:hover {
    background-color: {{ primary_btn_hover_bg }} !important;
    color: {{ primary_btn_hover_color }} !important;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18) !important;
  }

  /* Secondary Button */
  #shopify-section-{{ section.id }} .hb-spotlight-btn-secondary {
    color: {{ secondary_btn_color }} !important;
    background-color: {{ secondary_btn_bg }} !important;
    border-radius: {{ secondary_btn_radius }}px !important;
    transition: all 0.25s ease;
    {% if secondary_btn_border != 'transparent' and secondary_btn_border != blank %}
      border: 1px solid {{ secondary_btn_border }} !important;
      padding: 12px 24px !important;
    {% else %}
      border: none !important;
      padding: 12px 16px !important;
    {% endif %}
  }
  #shopify-section-{{ section.id }} .hb-spotlight-btn-secondary:hover {
    color: {{ secondary_btn_hover_color }} !important;
    background-color: {{ secondary_btn_hover_bg }} !important;
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .hb-spotlight-content h2 {
      {% if section.settings.heading_size_mobile != blank %}
        font-size: {{ section.settings.heading_size_mobile }}px !important;
      {% endif %}
    }
  }
</style>

<section class="hb-spotlight-section" id="spotlight">
  <div class="hb-container">
    <div class="hb-spotlight-grid">
      <div class="hb-spotlight-visual">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.heading | escape }}" width="480" height="480" loading="lazy">
        {% else %}
          <img src="{{ 'horizon-bottles-trio.jpg' | asset_url }}" alt="Botanical Care Dropper Trio" width="480" height="480" loading="lazy">
        {% endif %}
      </div>

      <div class="hb-spotlight-content">
        {% if section.settings.eyebrow != blank %}
          <span class="hb-eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        <h2>{{ section.settings.heading }}</h2>
        <div class="hb-spotlight-desc">
          {{ section.settings.description }}
        </div>

        <!-- Dynamic Feature Highlights -->
        <div class="hb-spotlight-features">
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              {% assign block_icon_col = block.settings.icon_color | default: icon_color %}
              {% assign block_icon_bg = block.settings.icon_bg | default: icon_bg %}
              <div class="hb-spotlight-feature" {{ block.shopify_attributes }}>
                <div class="hb-spotlight-icon" style="background-color: {{ block_icon_bg }} !important; color: {{ block_icon_col }} !important;">
                  {% case block.settings.icon %}
                    {% when 'shield' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    {% when 'bolt' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                    {% when 'target' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                    {% when 'droplet' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
                    {% when 'star' %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    {% else %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                  {% endcase %}
                </div>
                <div>
                  <h4>{{ block.settings.title }}</h4>
                  <span>{{ block.settings.subtitle }}</span>
                </div>
              </div>
            {% endfor %}
          {% else %}
            <!-- Defaults -->
            <div class="hb-spotlight-feature">
              <div class="hb-spotlight-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
              <div><h4>Non-Toxic</h4><span>Pure natural extracts</span></div>
            </div>
            <div class="hb-spotlight-feature">
              <div class="hb-spotlight-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></div>
              <div><h4>Fast Absorbing</h4><span>Sub-minute transdermal delivery</span></div>
            </div>
            <div class="hb-spotlight-feature">
              <div class="hb-spotlight-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg></div>
              <div><h4>Targeted Relief</h4><span>Calms joint & muscle tension</span></div>
            </div>
            <div class="hb-spotlight-feature">
              <div class="hb-spotlight-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg></div>
              <div><h4>Clean Formula</h4><span>Zero mineral oils or parabens</span></div>
            </div>
          {% endif %}
        </div>

        <div class="hb-hero-actions">
          {% if section.settings.primary_cta_text != blank %}
            <a href="{{ section.settings.primary_cta_link | default: '/collections/all' }}" class="hb-btn-primary hb-spotlight-btn-primary">
              {{ section.settings.primary_cta_text }}
            </a>
          {% endif %}
          {% if section.settings.secondary_cta_text != blank %}
            <a href="{{ section.settings.secondary_cta_link | default: '#ingredients' }}" class="hb-btn-link hb-spotlight-btn-secondary">
              {{ section.settings.secondary_cta_text }}
              {% if section.settings.show_secondary_arrow %} &rarr;{% endif %}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Spotlight Trio",
  "settings": [
    {
      "type": "header",
      "content": "Showcase Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Showcase Image (Trio Bottles)"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image Border Radius",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "image_shadow",
      "label": "Enable Image Shadow",
      "default": true
    },
    {
      "type": "header",
      "content": "Headings & Typography"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "DAILY RELIEF BLENDS"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#7a2a2b"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Eyebrow Font Size",
      "default": 13
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Botanical Care for Everyday Movement"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111827"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size (Desktop)",
      "default": 39
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 20,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size (Mobile)",
      "default": 28
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description Copy",
      "default": "<p>Targeted botanical formulas designed to calm tension and restore flexibility naturally without greasy residue or harsh synthetic ingredients.</p>"
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Description Text Color",
      "default": "#4b5563"
    },
    {
      "type": "range",
      "id": "desc_size",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Description Font Size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Feature Highlights & Icons"
    },
    {
      "type": "color",
      "id": "feature_icon_color",
      "label": "Icons Color",
      "default": "#7a2a2b"
    },
    {
      "type": "color",
      "id": "feature_icon_bg",
      "label": "Icon Circle Background Color",
      "default": "#fee6d4"
    },
    {
      "type": "color",
      "id": "feature_title_color",
      "label": "Feature Title Color",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "feature_subtitle_color",
      "label": "Feature Subtitle Color",
      "default": "#6b7280"
    },
    {
      "type": "header",
      "content": "Primary Action Button"
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary Button Label",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary Button URL"
    },
    {
      "type": "color",
      "id": "primary_btn_bg",
      "label": "Primary Button Background",
      "default": "#7a2a2b"
    },
    {
      "type": "color",
      "id": "primary_btn_color",
      "label": "Primary Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "primary_btn_border_color",
      "label": "Primary Button Border Color",
      "default": "#7a2a2b"
    },
    {
      "type": "color",
      "id": "primary_btn_hover_bg",
      "label": "Primary Button Hover Background",
      "default": "#5c1f20"
    },
    {
      "type": "color",
      "id": "primary_btn_hover_color",
      "label": "Primary Button Hover Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "primary_btn_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Primary Button Border Radius",
      "default": 30
    },
    {
      "type": "header",
      "content": "Secondary Action Button"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary Button Label",
      "default": "See Ingredients"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary Button URL"
    },
    {
      "type": "color",
      "id": "secondary_btn_color",
      "label": "Secondary Button Text Color",
      "default": "#7a2a2b"
    },
    {
      "type": "color",
      "id": "secondary_btn_bg",
      "label": "Secondary Button Background Color"
    },
    {
      "type": "color",
      "id": "secondary_btn_border_color",
      "label": "Secondary Button Border Color"
    },
    {
      "type": "color",
      "id": "secondary_btn_hover_color",
      "label": "Secondary Button Hover Text Color",
      "default": "#5c1f20"
    },
    {
      "type": "color",
      "id": "secondary_btn_hover_bg",
      "label": "Secondary Button Hover Background Color"
    },
    {
      "type": "range",
      "id": "secondary_btn_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Secondary Button Border Radius",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "show_secondary_arrow",
      "label": "Show Arrow After Label",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield / Clean" },
            { "value": "bolt", "label": "Lightning / Fast Absorbing" },
            { "value": "target", "label": "Target / Relief" },
            { "value": "check", "label": "Checkmark / Tested" },
            { "value": "droplet", "label": "Droplet / Pure" },
            { "value": "star", "label": "Star / Premium" }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "Non-Toxic"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Feature Subtitle",
          "default": "100% clean botanical extracts"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Custom Icon Color (Optional)"
        },
        {
          "type": "color",
          "id": "icon_bg",
          "label": "Custom Circle Background (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Spotlight Trio",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "shield",
            "title": "Non-Toxic",
            "subtitle": "Pure natural extracts"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "bolt",
            "title": "Fast Absorbing",
            "subtitle": "Sub-minute transdermal delivery"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "target",
            "title": "Targeted Relief",
            "subtitle": "Calms joint & muscle tension"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "check",
            "title": "Clean Formula",
            "subtitle": "Zero mineral oils or parabens"
          }
        }
      ]
    }
  ]
}
{% endschema %}
