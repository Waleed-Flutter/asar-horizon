{{ 'horizon-botanical.css' | asset_url | stylesheet_tag }}

<section class="hb-pain-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: {{ section.settings.bg_color }};">
  <div class="hb-container">
    <div class="hb-section-header">
      {% if section.settings.eyebrow != blank %}
        <span class="hb-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p>{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="hb-pain-grid hb-grid-cols-{{ section.settings.columns_desktop }}">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="hb-pain-card" {{ block.shopify_attributes }}>
            <div class="hb-pain-media">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" width="400" height="300" loading="lazy">
              {% else %}
                {% assign default_idx = forloop.index | modulo: 6 %}
                {% case default_idx %}
                  {% when 1 %}
                    <img src="{{ 'pain-desk-worker.jpg' | asset_url }}" alt="{{ block.settings.title | escape }}" width="400" height="300" loading="lazy">
                  {% when 2 %}
                    <img src="{{ 'pain-knee-runner.jpg' | asset_url }}" alt="{{ block.settings.title | escape }}" width="400" height="300" loading="lazy">
                  {% when 3 %}
                    <img src="{{ 'pain-lower-back.jpg' | asset_url }}" alt="{{ block.settings.title | escape }}" width="400" height="300" loading="lazy">
                  {% when 4 %}
                    <img src="{{ 'pain-family-posture.jpg' | asset_url }}" alt="{{ block.settings.title | escape }}" width="400" height="300" loading="lazy">
                  {% when 5 %}
                    <img src="{{ 'pain-chores-ironing.jpg' | asset_url }}" alt="{{ block.settings.title | escape }}" width="400" height="300" loading="lazy">
                  {% else %}
                    <img src="{{ 'pain-driving-seat.jpg' | asset_url }}" alt="{{ block.settings.title | escape }}" width="400" height="300" loading="lazy">
                {% endcase %}
              {% endif %}

              {% if block.settings.tag != blank %}
                <div class="hb-pain-tag-pill">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
                  {{ block.settings.tag }}
                </div>
              {% endif %}
            </div>

            <div class="hb-pain-body">
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.description }}</p>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Default Fallback Cards -->
        <div class="hb-pain-card">
          <div class="hb-pain-media">
            <img src="{{ 'pain-desk-worker.jpg' | asset_url }}" alt="Desk Worker Shoulder Pain" width="400" height="300" loading="lazy">
            <div class="hb-pain-tag-pill">Upper Body</div>
          </div>
          <div class="hb-pain-body">
            <h3>LOWER BACK & SHOULDER TENSION</h3>
            <p>Calms tight trapezius muscles and neck stiffness caused by screen time and desk work.</p>
          </div>
        </div>
      {% endif %}
    </div>

    {% if section.settings.bottom_note != blank %}
      <div style="text-align: center; margin-top: 36px; font-size: 0.85rem; color: #6b7280;">
        {{ section.settings.bottom_note }}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Pain Points Grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "REAL RELIEF FOR REAL LIFE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Day Doesn't Stop When Your Body Feels Tired."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Formulated for targeted comfort where tension, fatigue, and soreness build up most during busy routines."
    },
    {
      "type": "text",
      "id": "bottom_note",
      "label": "Bottom Footer Note",
      "default": "Clinically informed botanicals designed for rapid cutaneous absorption."
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on Desktop",
      "options": [
        { "value": "2", "label": "2 Columns" },
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ],
      "default": "3"
    },
    {
      "type": "header",
      "content": "Section Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fafbfa"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "pain_card",
      "name": "Pain Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Photo with Heat Indicator"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Category Pill Tag",
          "default": "Upper Body"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "LOWER BACK & SHOULDER TENSION"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Card Description",
          "default": "Calms tight trapezius muscles and neck stiffness after hours seated at the desk."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional Card Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pain Points Grid",
      "blocks": [
        {
          "type": "pain_card",
          "settings": {
            "tag": "Upper Body",
            "title": "LOWER BACK & SHOULDER TENSION",
            "description": "Calms tight trapezius muscles and neck stiffness caused by prolonged screen time, bad ergonomic chairs, and desk work."
          }
        },
        {
          "type": "pain_card",
          "settings": {
            "tag": "Active Recovery",
            "title": "RUNNING & JOINT DISCOMFORT",
            "description": "Eases stressed knees and tight calf muscles after athletic workouts, running pavement, or high-intensity training sessions."
          }
        },
        {
          "type": "pain_card",
          "settings": {
            "tag": "Lumbar Relief",
            "title": "LUMBAR & SPINE STIFFNESS",
            "description": "Soothes deep muscular tightness along lumbar vertebrae and sacral joints so you can stand and walk with effortless posture."
          }
        },
        {
          "type": "pain_card",
          "settings": {
            "tag": "Everyday Life",
            "title": "POSTURE & EVERYDAY STRAIN",
            "description": "Relieves aches from picking up children, prolonged carpet floor sitting, or awkward twisting throughout the busy day."
          }
        },
        {
          "type": "pain_card",
          "settings": {
            "tag": "Domestic Chores",
            "title": "DAILY CHORES & BENDING FATIGUE",
            "description": "Provides soothing comfort from hours on your feet, repetitive bending, grocery carrying, and laundry chores."
          }
        },
        {
          "type": "pain_card",
          "settings": {
            "tag": "Travel & Commute",
            "title": "LONG DRIVES & TRAVEL FATIGUE",
            "description": "Counteracts lower back compression and hip tightness resulting from daily commutes, bumper-to-bumper traffic, and flight travel."
          }
        }
      ]
    }
  ]
}
{% endschema %}
