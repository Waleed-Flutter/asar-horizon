<section id="hb-pain-{{ section.id }}" class="hb-pain-section" style="
  {% liquid
    assign bg = section.settings.bg_color | default: '#fafbfa'
    if bg contains 'settings.' or bg contains '{{'
      assign bg = 'var(--color-background, #fafbfa)'
    endif
    assign h_col = section.settings.heading_color | default: '#111827'
    assign s_col = section.settings.subheading_color | default: '#4b5563'
    assign eye_col = section.settings.eyebrow_color | default: '#257942'
    assign c_bg = section.settings.card_bg | default: '#ffffff'
    assign c_rad = section.settings.card_border_radius | default: 16
    assign c_border = section.settings.card_border_color | default: '#e5ece6'
    assign c_title = section.settings.card_title_color | default: '#111827'
    assign c_desc = section.settings.card_desc_color | default: '#6b7280'
    assign t_col = section.settings.card_tag_color | default: '#257942'
    assign t_bg = section.settings.card_tag_bg | default: '#f2f7f3'
  %}
  background-color: {{ bg }};
  padding-top: {{ section.settings.padding_top | default: 96 }}px;
  padding-bottom: {{ section.settings.padding_bottom | default: 96 }}px;
">
  <div class="hb-container">
    {% if section.settings.heading != blank or section.settings.eyebrow != blank %}
      <div class="hb-section-header">
        {% if section.settings.eyebrow != blank %}
          <span class="hb-eyebrow" style="color: {{ eye_col }};">{{ section.settings.eyebrow }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 style="color: {{ h_col }};">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p style="color: {{ s_col }};">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="hb-pain-grid" style="--pain-cols: {{ section.settings.columns_desktop | default: 3 }};">
      {% for block in section.blocks %}
        <div class="hb-pain-card" {{ block.shopify_attributes }} style="
          background-color: {{ c_bg }};
          border-radius: {{ c_rad }}px;
          border-color: {{ c_border }};
        ">
          <div class="hb-pain-img-box">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" width="380" height="260" loading="lazy">
            {% elsif block.settings.fallback_image != blank %}
              <img src="{{ block.settings.fallback_image | asset_url }}" alt="{{ block.settings.title | escape }}" width="380" height="260" loading="lazy">
            {% endif %}
            
            {% if block.settings.category != blank %}
              <span class="hb-pain-badge" style="background-color: {{ t_bg }}; color: {{ t_col }};">{{ block.settings.category }}</span>
            {% endif %}
          </div>
          <div class="hb-pain-card-body">
            {% if block.settings.title != blank %}
              <h3 class="hb-pain-card-title" style="color: {{ c_title }};">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.description != blank %}
              <p class="hb-pain-card-desc" style="color: {{ c_desc }};">{{ block.settings.description }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.bottom_note != blank %}
      <div class="hb-pain-bottom-note" style="color: {{ section.settings.bottom_note_color | default: '#6b7280' }};">
        <p>{{ section.settings.bottom_note }}</p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Pain Points Grid",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "REAL RELIEF FOR REAL LIFE"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#257942"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Day Doesn't Stop When Your Body Feels Tired."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111827"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Formulated for targeted comfort where tension, fatigue, and soreness build up most during busy routines."
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#4b5563"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 3
    },
    {
      "type": "header",
      "content": "Card Styling"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 16
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color",
      "default": "#e5ece6"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card Title Color",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "card_desc_color",
      "label": "Card Description Color",
      "default": "#6b7280"
    },
    {
      "type": "color",
      "id": "card_tag_color",
      "label": "Category Tag Text Color",
      "default": "#257942"
    },
    {
      "type": "color",
      "id": "card_tag_bg",
      "label": "Category Tag Background",
      "default": "#f2f7f3"
    },
    {
      "type": "header",
      "content": "Bottom Note"
    },
    {
      "type": "text",
      "id": "bottom_note",
      "label": "Bottom Disclaimer / Note",
      "default": "Clinically informed botanicals designed for rapid cutaneous absorption."
    },
    {
      "type": "color",
      "id": "bottom_note_color",
      "label": "Bottom Note Color",
      "default": "#6b7280"
    },
    {
      "type": "header",
      "content": "Section Layout & Padding"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fafbfa"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "pain_card",
      "name": "Pain / Lifestyle Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Card Image"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "Theme Asset Filename",
          "default": "pain-desk-worker.jpg"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category / Tag",
          "default": "WORK FROM HOME"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Area / Concern Title",
          "default": "LOWER BACK & SHOULDER TENSION"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Calms tight trapezius muscles and neck stiffness caused by prolonged screen time, bad ergonomic chairs, and desk work."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pain Points Grid"
    }
  ]
}
{% endschema %}
