<section id="hb-faq-{{ section.id }}" class="hb-faq-section" style="
  {% liquid
    assign bg = section.settings.background_color | default: '#ffffff'
    if bg contains 'settings.' or bg contains '{{'
      assign bg = 'var(--color-background, #ffffff)'
    endif
    assign h_col = section.settings.heading_color | default: '#111827'
    assign s_col = section.settings.subheading_color | default: '#4b5563'
    assign eye_col = section.settings.eyebrow_color | default: '#257942'
    assign item_bg = section.settings.item_bg | default: '#ffffff'
    assign item_rad = section.settings.item_border_radius | default: 12
    assign item_border = section.settings.item_border_color | default: '#e5ece6'
    assign q_col = section.settings.question_color | default: '#111827'
    assign a_col = section.settings.answer_color | default: '#4b5563'
    assign i_col = section.settings.icon_color | default: '#257942'
  %}
  background-color: {{ bg }};
  padding-top: {{ section.settings.padding_top | default: 88 }}px;
  padding-bottom: {{ section.settings.padding_bottom | default: 88 }}px;
">
  <div class="hb-container">
    {% if section.settings.heading != blank or section.settings.eyebrow != blank %}
      <div class="hb-section-header">
        {% if section.settings.eyebrow != blank %}
          <span class="hb-eyebrow" style="color: {{ eye_col }};">{{ section.settings.eyebrow }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 style="color: {{ h_col }};">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p style="color: {{ s_col }};">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="hb-faq-list" data-allow-multiple="{{ section.settings.allow_multiple_open }}">
      {% for block in section.blocks %}
        <div class="hb-faq-item{% if block.settings.open_by_default %} active{% endif %}" {{ block.shopify_attributes }} style="
          background-color: {{ item_bg }};
          border-radius: {{ item_rad }}px;
          border-color: {{ item_border }};
        ">
          <button class="hb-faq-question" type="button" aria-expanded="{% if block.settings.open_by_default %}true{% else %}false{% endif %}">
            <span style="color: {{ q_col }};">{{ block.settings.question }}</span>
            <span class="hb-faq-toggle-icon" style="color: {{ i_col }};">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </span>
          </button>
          <div class="hb-faq-answer">
            <div class="hb-faq-answer-inner">
              <p style="color: {{ a_col }};">{{ block.settings.answer }}</p>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (function() {
    function initFaq(section) {
      if (!section) return;
      const list = section.querySelector('.hb-faq-list');
      if (!list) return;
      const allowMultiple = list.getAttribute('data-allow-multiple') === 'true';
      const items = section.querySelectorAll('.hb-faq-item');

      items.forEach(item => {
        const btn = item.querySelector('.hb-faq-question');
        if (!btn || btn.dataset.faqBound) return;
        btn.dataset.faqBound = 'true';

        btn.addEventListener('click', () => {
          const isActive = item.classList.contains('active');
          if (!allowMultiple) {
            items.forEach(i => {
              if (i !== item) {
                i.classList.remove('active');
                const b = i.querySelector('.hb-faq-question');
                if (b) b.setAttribute('aria-expanded', 'false');
              }
            });
          }
          item.classList.toggle('active', !isActive);
          btn.setAttribute('aria-expanded', !isActive ? 'true' : 'false');
        });
      });
    }

    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.hb-faq-section').forEach(initFaq);
    });
    document.addEventListener('shopify:section:load', function(e) {
      if (e.target.classList.contains('hb-faq-section')) initFaq(e.target);
    });
  })();
</script>

{% schema %}
{
  "name": "FAQ Accordion",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "FREQUENTLY ASKED QUESTIONS"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#257942"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Got Questions? We've Got Answers."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111827"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need to know about our organic botanical drops, application techniques, and delivery guarantees."
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#4b5563"
    },
    {
      "type": "checkbox",
      "id": "allow_multiple_open",
      "label": "Allow multiple items open simultaneously",
      "default": false
    },
    {
      "type": "header",
      "content": "Accordion Item Styling"
    },
    {
      "type": "color",
      "id": "item_bg",
      "label": "Item Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "item_border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Item Border Radius",
      "default": 12
    },
    {
      "type": "color",
      "id": "item_border_color",
      "label": "Item Border Color",
      "default": "#e5ece6"
    },
    {
      "type": "color",
      "id": "question_color",
      "label": "Question Text Color",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "answer_color",
      "label": "Answer Text Color",
      "default": "#4b5563"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Toggle Icon Color",
      "default": "#257942"
    },
    {
      "type": "header",
      "content": "Section Layout & Padding"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How quickly can I expect to feel relief?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Most customers notice an immediate cooling and soothing sensation within 2 to 3 minutes of application, followed by deeper therapeutic warmth and muscle ease around 15 minutes."
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion"
    }
  ]
}
{% endschema %}
