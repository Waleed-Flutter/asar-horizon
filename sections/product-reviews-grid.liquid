{{ 'horizon-botanical.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color | default: '#ffffff' }} !important;
    padding-top: {{ section.settings.padding_top | default: 60 }}px !important;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px !important;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | default: 60 | times: 0.65 | round }}px !important;
      padding-bottom: {{ section.settings.padding_bottom | default: 60 | times: 0.65 | round }}px !important;
    }
  }

  #shopify-section-{{ section.id }} .hb-reviews-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 16px;
    border-bottom: 1px solid #f0f2f0;
    padding-bottom: 24px;
    margin-bottom: 28px;
  }

  #shopify-section-{{ section.id }} .hb-reviews-header-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  #shopify-section-{{ section.id }} .hb-reviews-title {
    color: {{ section.settings.heading_color | default: '#111827' }};
    font-size: {{ section.settings.heading_size | default: 22 }}px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.25;
    margin: 0 0 6px;
  }

  #shopify-section-{{ section.id }} .hb-reviews-summary {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  #shopify-section-{{ section.id }} .hb-reviews-summary-score {
    font-weight: 700;
    font-size: 15px;
    color: #111827;
  }

  #shopify-section-{{ section.id }} .hb-reviews-summary-count {
    font-size: 13.5px;
    color: #4b5563;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .hb-reviews-thumbnails-strip {
    display: flex;
    gap: 10px;
    margin-top: 6px;
  }

  #shopify-section-{{ section.id }} .hb-reviews-thumb-item {
    width: 64px;
    height: 64px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #e5e7eb;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .hb-reviews-thumb-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .hb-reviews-header-right {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }

  #shopify-section-{{ section.id }} .hb-reviews-write-btn {
    background-color: {{ section.settings.button_bg | default: '#2ca24d' }} !important;
    color: #ffffff !important;
    border-radius: 50px !important;
    padding: 9px 24px !important;
    font-weight: 600 !important;
    font-size: 13.5px !important;
    border: none !important;
    text-decoration: none !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: all 0.2s ease !important;
  }

  #shopify-section-{{ section.id }} .hb-reviews-write-btn:hover {
    background-color: #23863e !important;
    transform: translateY(-1px) !important;
  }

  /* Horizontal Cards Grid */
  #shopify-section-{{ section.id }} .hb-reviews-grid {
    display: grid !important;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr) !important;
    gap: {{ section.settings.grid_gap | default: 20 }}px !important;
    align-items: stretch !important;
  }

  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .hb-reviews-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 18px !important;
    }
  }

  @media (max-width: 680px) {
    #shopify-section-{{ section.id }} .hb-reviews-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile | default: 1 }}, 1fr) !important;
      gap: 16px !important;
    }
  }

  /* Each Review Card (Matching Reference) */
  #shopify-section-{{ section.id }} .hb-review-card {
    background-color: {{ section.settings.card_bg | default: '#ffffff' }} !important;
    border: 1px solid {{ section.settings.card_border_color | default: '#eef0ee' }} !important;
    border-radius: {{ section.settings.card_radius | default: 12 }}px !important;
    padding: 22px 22px !important;
    box-sizing: border-box !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-start !important;
    position: relative !important;
    transition: all 0.25s ease !important;
  }

  #shopify-section-{{ section.id }} .hb-review-card:hover {
    border-color: #d1d5db !important;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04) !important;
  }

  /* 1. Green Stars at the top */
  #shopify-section-{{ section.id }} .hb-review-stars {
    display: flex !important;
    align-items: center !important;
    gap: 3px !important;
    color: {{ section.settings.star_color | default: '#2ca24d' }} !important;
    font-size: 18px !important;
    margin-bottom: 10px !important;
  }

  /* 2. Reviewer Name */
  #shopify-section-{{ section.id }} .hb-review-author {
    font-weight: 700 !important;
    font-size: 15px !important;
    color: #111827 !important;
    line-height: 1.3 !important;
    margin-bottom: 2px !important;
  }

  /* 3. Date below author */
  #shopify-section-{{ section.id }} .hb-review-date {
    font-size: 12.5px !important;
    color: #6b7280 !important;
    font-weight: 400 !important;
    margin-bottom: 12px !important;
  }

  /* 4. Review text */
  #shopify-section-{{ section.id }} .hb-review-body {
    font-size: 13.5px !important;
    line-height: 1.55 !important;
    color: #374151 !important;
    margin-bottom: 14px !important;
    flex-grow: 1 !important;
  }

  #shopify-section-{{ section.id }} .hb-review-body p {
    margin: 0 !important;
  }

  /* 5. Customer Photo Thumbnail at bottom-left */
  #shopify-section-{{ section.id }} .hb-review-photo-wrapper {
    margin-top: auto !important;
    display: flex !important;
    justify-content: flex-start !important;
  }

  #shopify-section-{{ section.id }} .hb-review-photo {
    width: 68px !important;
    height: 68px !important;
    border-radius: 10px !important;
    overflow: hidden !important;
    border: 1px solid #e5e7eb !important;
    object-fit: cover !important;
    display: block !important;
    transition: transform 0.2s ease !important;
  }

  #shopify-section-{{ section.id }} .hb-review-photo:hover {
    transform: scale(1.05) !important;
  }

  /* App Block Slot */
  #shopify-section-{{ section.id }} .hb-reviews-app-slot {
    margin-top: 16px !important;
  }
{%- endstyle -%}

<section class="hb-reviews-section">
  <div class="hb-container">
    <div class="hb-reviews-header">
      <div class="hb-reviews-header-left">
        {% if section.settings.heading != blank %}
          <h2 class="hb-reviews-title">{{ section.settings.heading }}</h2>
        {% endif %}
        <div class="hb-reviews-summary">
          <span class="hb-reviews-summary-score">{{ section.settings.summary_rating | default: '5.0' }}</span>
          <span class="hb-reviews-summary-count">{{ section.settings.summary_text | default: '3 reviews' }}</span>
        </div>

        {% if section.settings.show_header_thumbs %}
          <div class="hb-reviews-thumbnails-strip">
            {% for block in section.blocks %}
              {% if block.type == 'review_card' and block.settings.reviewer_photo != blank %}
                <div class="hb-reviews-thumb-item">
                  {{ block.settings.reviewer_photo | image_url: width: 140 | image_tag: loading: 'lazy', alt: block.settings.reviewer_name }}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="hb-reviews-header-right">
        {% if section.settings.button_text != blank %}
          <a href="#" class="hb-reviews-write-btn" onclick="try{if(window.jdgm&&typeof jdgm.showReviewForm==='function'){jdgm.showReviewForm();}}catch(e){};return false;">{{ section.settings.button_text }}</a>
        {% endif %}
      </div>
    </div>

    {% assign review_blocks = section.blocks | where: "type", "review_card" %}
    {% if review_blocks.size > 0 %}
      <div class="hb-reviews-grid">
        {% for block in review_blocks %}
          <div class="hb-review-card" {{ block.shopify_attributes }}>
            <!-- 1. Green Stars at Top -->
            <div class="hb-review-stars">
              {%- assign star_count = block.settings.rating | default: 5 -%}
              {% for i in (1..star_count) %}
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              {% endfor %}
            </div>

            <!-- 2. Reviewer Name -->
            <div class="hb-review-author">{{ block.settings.reviewer_name }}</div>

            <!-- 3. Date -->
            {% if block.settings.review_date != blank %}
              <div class="hb-review-date">{{ block.settings.review_date }}</div>
            {% endif %}

            <!-- 4. Review Content -->
            <div class="hb-review-body">
              <p>{{ block.settings.review_text }}</p>
            </div>

            <!-- 5. Customer Photo at Bottom Left -->
            {% if block.settings.reviewer_photo != blank %}
              <div class="hb-review-photo-wrapper">
                {{ block.settings.reviewer_photo | image_url: width: 200 | image_tag: loading: 'lazy', class: 'hb-review-photo', alt: block.settings.reviewer_name }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% for block in section.blocks %}
      {% if block.type == '@app' %}
        <div class="hb-reviews-app-slot" {{ block.shopify_attributes }}>
          {% render block %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Product Reviews Grid",
  "tag": "section",
  "class": "product-reviews-grid-section",
  "settings": [
    {
      "type": "header",
      "content": "Header & Action Button"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Reviews"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111827"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 22
    },
    {
      "type": "text",
      "id": "summary_rating",
      "label": "Rating Score",
      "default": "5.0"
    },
    {
      "type": "text",
      "id": "summary_text",
      "label": "Review Count Text",
      "default": "3 reviews"
    },
    {
      "type": "checkbox",
      "id": "show_header_thumbs",
      "label": "Show Customer Photo Thumbnails in Header",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Write a Review Button Text",
      "default": "Write a review"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Write a Review Button Color",
      "default": "#2ca24d"
    },
    {
      "type": "header",
      "content": "Horizontal Cards Layout"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop Columns (Horizontal Row)",
      "options": [
        { "value": "3", "label": "3 Columns (Recommended)" },
        { "value": "2", "label": "2 Columns" },
        { "value": "4", "label": "4 Columns" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile Columns",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 12,
      "max": 36,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap / Spacing",
      "default": 20
    },
    {
      "type": "header",
      "content": "Card Styling & Colors"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color",
      "default": "#eef0ee"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 6,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 12
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Stars Color",
      "default": "#2ca24d"
    },
    {
      "type": "header",
      "content": "Section Background & Spacing"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "review_card",
      "name": "Review Card",
      "settings": [
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer Name",
          "default": "Sana"
        },
        {
          "type": "text",
          "id": "review_date",
          "label": "Review Date",
          "default": "09/11/2026"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating Stars",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Content",
          "default": "I bought Tibra Pain Ease Oil a week ago because I was having pain in my knee. I used this oil and got amazing results. The warm sensation really penetrates and soothes the affected area. I highly recommend this oil."
        },
        {
          "type": "image_picker",
          "id": "reviewer_photo",
          "label": "Customer Photo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Reviews Grid",
      "blocks": [
        {
          "type": "review_card",
          "settings": {
            "reviewer_name": "Sana",
            "review_date": "09/11/2026",
            "rating": 5,
            "review_text": "I bought Tibra Pain Ease Oil a week ago because I was having pain in my knee. I used this oil and got amazing results. The warm sensation really penetrates and soothes the affected area. I highly recommend this oil."
          }
        },
        {
          "type": "review_card",
          "settings": {
