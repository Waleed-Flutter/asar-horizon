{{ 'horizon-botanical.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign brand_btn_bg = section.settings.button_bg | default: '#7A2A2B'
  assign brand_btn_text = section.settings.button_text_color | default: '#ffffff'
  assign brand_star_color = section.settings.star_color | default: '#7A2A2B'
  assign default_shop_domain = shop.permanent_domain | default: 'y8e3v3-1j.myshopify.com'
  assign current_prod_id = product.id | default: 10322677891146
-%}

{%- style -%}
  /* Hide the raw duplicate Judge.me default widget so only our styled botanical grid displays */
  #judgeme_product_reviews,
  .jdgm-widget.jdgm-review-widget {
    display: none !important;
  }

  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color | default: '#ffffff' }};
    padding-top: {{ section.settings.padding_top | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | default: 60 | times: 0.65 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 60 | times: 0.65 | round }}px;
    }
  }

  #shopify-section-{{ section.id }} .hb-reviews-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }

  #shopify-section-{{ section.id }} .hb-reviews-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 16px;
    border-bottom: 1px solid #f0f2f0;
    padding-bottom: 24px;
    margin-bottom: 28px;
  }

  #shopify-section-{{ section.id }} .hb-reviews-header-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  #shopify-section-{{ section.id }} .hb-reviews-title {
    color: {{ section.settings.heading_color | default: '#111827' }};
    font-size: {{ section.settings.heading_size | default: 24 }}px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.25;
    margin: 0 0 6px;
  }

  #shopify-section-{{ section.id }} .hb-reviews-summary {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  #shopify-section-{{ section.id }} .hb-reviews-summary-score {
    font-weight: 700;
    font-size: 16px;
    color: #111827;
  }

  #shopify-section-{{ section.id }} .hb-reviews-summary-count {
    font-size: 13.5px;
    color: #6b7280;
    font-weight: 400;
  }

  /* Photo Strip Under Header */
  #shopify-section-{{ section.id }} .hb-reviews-thumbnails-strip {
    display: flex;
    gap: 10px;
    margin-top: 6px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .hb-reviews-thumb-item {
    width: 64px;
    height: 64px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #e5e7eb;
    flex-shrink: 0;
    cursor: pointer;
    background: #f9fafb;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  #shopify-section-{{ section.id }} .hb-reviews-thumb-item:hover {
    transform: scale(1.05);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
  }

  #shopify-section-{{ section.id }} .hb-reviews-thumb-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .hb-reviews-header-right {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
    flex-wrap: wrap;
  }

  /* Write a Review Button */
  #shopify-section-{{ section.id }} .hb-reviews-write-btn {
    background-color: {{ brand_btn_bg }} !important;
    color: {{ brand_btn_text }} !important;
    border-radius: 9999px !important;
    padding: 10px 24px !important;
    font-weight: 600 !important;
    font-size: 14px !important;
    border: 1px solid {{ brand_btn_bg }} !important;
    text-decoration: none !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: all 0.2s ease !important;
    cursor: pointer !important;
    box-shadow: none !important;
    line-height: normal !important;
  }

  #shopify-section-{{ section.id }} .hb-reviews-write-btn:hover {
    filter: brightness(0.92);
    transform: translateY(-1px);
  }

  /* Filter and Sort Buttons */
  #shopify-section-{{ section.id }} .hb-icon-btn {
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    background: #ffffff;
    color: #374151;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
  }

  #shopify-section-{{ section.id }} .hb-icon-btn:hover {
    border-color: #9ca3af;
    background: #f9fafb;
  }

  /* Dropdown Menus for Filter and Sort */
  .hb-dropdown-menu {
    position: absolute;
    top: 44px;
    right: 0;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    min-width: 170px;
    z-index: 100;
    display: none;
    flex-direction: column;
    padding: 6px 0;
  }

  .hb-dropdown-menu.active {
    display: flex;
  }

  .hb-dropdown-item {
    padding: 8px 16px;
    font-size: 13.5px;
    color: #374151;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    transition: background 0.15s ease;
    width: 100%;
  }

  .hb-dropdown-item:hover {
    background: #f3f4f6;
    color: #111827;
  }

  /* 3-Column Horizontal Grid */
  #shopify-section-{{ section.id }} .hb-reviews-grid {
    display: grid !important;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr) !important;
    gap: {{ section.settings.grid_gap | default: 20 }}px !important;
    align-items: stretch !important;
  }

  @media (max-width: 990px) {
    #shopify-section-{{ section.id }} .hb-reviews-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 16px !important;
    }
  }

  @media (max-width: 640px) {
    #shopify-section-{{ section.id }} .hb-reviews-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile | default: 1 }}, 1fr) !important;
      gap: 14px !important;
    }
  }

  /* Review Card */
  #shopify-section-{{ section.id }} .hb-review-card {
    background-color: {{ section.settings.card_bg | default: '#ffffff' }} !important;
    border: 1px solid {{ section.settings.card_border_color | default: '#eef0ee' }} !important;
    border-radius: {{ section.settings.card_radius | default: 12 }}px !important;
    padding: 22px !important;
    box-sizing: border-box !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-start !important;
    position: relative !important;
    transition: all 0.25s ease !important;
    height: 100% !important;
  }

  #shopify-section-{{ section.id }} .hb-review-card:hover {
    border-color: #d1d5db !important;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04) !important;
  }

  /* 1. Review Stars */
  #shopify-section-{{ section.id }} .hb-review-stars {
    display: flex !important;
    align-items: center !important;
    gap: 3px !important;
    color: {{ brand_star_color }} !important;
    margin-bottom: 10px !important;
  }

  #shopify-section-{{ section.id }} .hb-review-stars svg {
    fill: currentColor;
    width: 18px;
    height: 18px;
  }

  /* 2. Reviewer Name & Verified Badge */
  #shopify-section-{{ section.id }} .hb-review-author-wrap {
    display: flex !important;
    align-items: center !important;
    gap: 6px !important;
    margin-bottom: 3px !important;
    flex-wrap: wrap !important;
  }

  #shopify-section-{{ section.id }} .hb-review-author {
    font-weight: 700 !important;
    font-size: 15.5px !important;
    color: #111827 !important;
    line-height: 1.3 !important;
  }

  #shopify-section-{{ section.id }} .hb-review-verified {
    display: inline-flex !important;
    align-items: center !important;
    gap: 3px !important;
    font-size: 11px !important;
    font-weight: 600 !important;
    color: #059669 !important;
    background: #ecfdf5 !important;
    padding: 2px 7px !important;
    border-radius: 20px !important;
  }

  /* 3. Date */
  #shopify-section-{{ section.id }} .hb-review-date {
    font-size: 12.5px !important;
    color: #6b7280 !important;
    font-weight: 400 !important;
    margin-bottom: 12px !important;
  }

  /* 4. Review text */
  #shopify-section-{{ section.id }} .hb-review-body {
    font-size: 13.5px !important;
    line-height: 1.55 !important;
    color: #374151 !important;
    margin-bottom: 14px !important;
    flex-grow: 1 !important;
  }

  #shopify-section-{{ section.id }} .hb-review-body p {
    margin: 0 !important;
  }

  /* 5. Customer Photo at Bottom Left */
  #shopify-section-{{ section.id }} .hb-review-photo-wrapper {
    margin-top: auto !important;
    display: flex !important;
    justify-content: flex-start !important;
  }

  #shopify-section-{{ section.id }} .hb-review-photo-link {
    width: 68px !important;
    height: 68px !important;
    border-radius: 10px !important;
    overflow: hidden !important;
    border: 1px solid #e5e7eb !important;
    display: inline-block !important;
    cursor: pointer !important;
    background: #f9fafb;
    transition: transform 0.2s ease !important;
  }

  #shopify-section-{{ section.id }} .hb-review-photo-link:hover {
    transform: scale(1.05) !important;
  }

  #shopify-section-{{ section.id }} .hb-review-photo {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
  }

  /* ===================== MODAL POPUPS ===================== */
  .hb-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.6);
    z-index: 100000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 16px;
    box-sizing: border-box;
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .hb-modal-overlay.active {
    display: flex;
    opacity: 1;
  }

  .hb-modal-box {
    background: #ffffff;
    border-radius: 16px;
    max-width: 520px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    padding: 28px;
    box-sizing: border-box;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    position: relative;
    transform: scale(0.95);
    transition: transform 0.25s ease;
  }

  .hb-modal-overlay.active .hb-modal-box {
    transform: scale(1);
  }

  .hb-modal-close {
    position: absolute;
    top: 18px;
    right: 18px;
    background: #f3f4f6;
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    color: #4b5563;
    transition: background 0.2s ease;
  }

  .hb-modal-close:hover {
    background: #e5e7eb;
    color: #111827;
  }

  .hb-form-title {
    font-size: 20px;
    font-weight: 700;
    color: #111827;
    margin: 0 0 16px 0;
  }

  .hb-form-group {
    margin-bottom: 16px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hb-form-label {
    font-size: 13px;
    font-weight: 600;
    color: #374151;
    margin-bottom: 6px;
  }

  .hb-form-stars {
    display: flex;
    gap: 6px;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .hb-form-star-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: #d1d5db;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  #shopify-section-{{ section.id }} .hb-form-star-btn svg {
    width: 26px;
    height: 26px;
    fill: currentColor;
  }

  #shopify-section-{{ section.id }} .hb-form-star-btn.active,
  #shopify-section-{{ section.id }} .hb-form-star-btn.hover {
    color: {{ brand_star_color }} !important;
    transform: scale(1.1);
  }

  .hb-form-input,
  .hb-form-textarea {
    width: 100%;
    padding: 10px 14px;
    border-radius: 8px;
    border: 1px solid #d1d5db;
    font-size: 14px;
    box-sizing: border-box;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  #shopify-section-{{ section.id }} .hb-form-input:focus,
  #shopify-section-{{ section.id }} .hb-form-textarea:focus {
    border-color: {{ brand_btn_bg }} !important;
    box-shadow: 0 0 0 3px rgba(122, 42, 43, 0.15) !important;
  }

  .hb-form-textarea {
    resize: vertical;
    min-height: 90px;
  }

  .hb-file-upload-area {
    width: 100%;
    border: 2px dashed #d1d5db;
    border-radius: 10px;
    padding: 16px;
    text-align: center;
    box-sizing: border-box;
    cursor: pointer;
    background: #f9fafb;
    transition: all 0.2s ease;
    display: block;
  }

  #shopify-section-{{ section.id }} .hb-file-upload-area:hover {
    border-color: {{ brand_btn_bg }} !important;
    background: #fdf8f8 !important;
  }

  #shopify-section-{{ section.id }} .hb-file-upload-icon {
    stroke: {{ brand_btn_bg }} !important;
    margin-bottom: 4px;
  }

  .hb-file-upload-area input {
    display: none;
  }

  .hb-upload-preview {
    margin-top: 10px;
    display: none;
    gap: 8px;
    flex-wrap: wrap;
  }

  .hb-upload-preview img {
    width: 60px;
    height: 60px;
    border-radius: 8px;
    object-fit: cover;
    border: 1px solid #e5e7eb;
  }

  #shopify-section-{{ section.id }} .hb-form-submit-btn {
    width: 100%;
    background: {{ brand_btn_bg }} !important;
    color: {{ brand_btn_text }} !important;
    border: 1px solid {{ brand_btn_bg }} !important;
    border-radius: 50px;
    padding: 12px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-top: 10px;
  }

  #shopify-section-{{ section.id }} .hb-form-submit-btn:hover {
    filter: brightness(0.9);
  }

  #shopify-section-{{ section.id }} .hb-form-submit-btn:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .hb-form-success {
    display: none;
    text-align: center;
    padding: 24px 10px;
  }

  #shopify-section-{{ section.id }} .hb-form-success-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #fbf0f0 !important;
    color: {{ brand_btn_bg }} !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
  }

  #shopify-section-{{ section.id }} .hb-form-success-icon svg {
    stroke: {{ brand_btn_bg }} !important;
  }

  /* Lightbox */
  .hb-lightbox-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.85);
    z-index: 100000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    box-sizing: border-box;
  }

  .hb-lightbox-overlay.active {
    display: flex;
  }

  .hb-lightbox-img {
    max-width: 90vw;
    max-height: 85vh;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    object-fit: contain;
  }
{%- endstyle -%}

<section class="hb-reviews-section">
  <div class="hb-reviews-container">
    <div class="hb-reviews-header">
      <div class="hb-reviews-header-left">
        {% if section.settings.heading != blank %}
          <h2 class="hb-reviews-title">{{ section.settings.heading }}</h2>
        {% endif %}
        <div class="hb-reviews-summary">
          <span class="hb-reviews-summary-score" id="hb-summary-score-{{ section.id }}">{{ section.settings.summary_rating | default: '5.0' }}</span>
          <span class="hb-reviews-summary-count" id="hb-summary-count-{{ section.id }}">{{ section.settings.summary_text | default: '3 reviews' }}</span>
        </div>

        {% if section.settings.show_header_thumbs %}
          <div class="hb-reviews-thumbnails-strip" id="hb-header-thumbs-{{ section.id }}">
            {%- assign header_photo_count = 0 -%}
            {% for block in section.blocks %}
              {% if block.type == 'review_card' %}
                {%- assign card_photo = block.settings.reviewer_photo -%}
                {%- if card_photo != blank -%}
                  {%- assign header_photo_count = header_photo_count | plus: 1 -%}
                  <div class="hb-reviews-thumb-item" onclick="openHbReviewsLightbox('{{ card_photo | image_url: width: 1000 }}')">
                    {{ card_photo | image_url: width: 140 | image_tag: loading: 'lazy', alt: block.settings.reviewer_name }}
                  </div>
                {%- elsif block.settings.fallback_photo != 'none' -%}
                  {%- assign header_photo_count = header_photo_count | plus: 1 -%}
                  {%- capture fallback_src -%}customer-review-photo-{{ forloop.index | default: 1 }}.jpg{%- endcapture -%}
                  <div class="hb-reviews-thumb-item" onclick="openHbReviewsLightbox('{{ fallback_src | asset_url }}')">
                    <img src="{{ fallback_src | asset_url }}" alt="Review photo {{ forloop.index }}" loading="lazy">
                  </div>
                {%- endif -%}
              {% endif %}
            {% endfor %}

            {%- if header_photo_count == 0 -%}
              <div class="hb-reviews-thumb-item" onclick="openHbReviewsLightbox('{{ 'customer-review-photo-1.jpg' | asset_url }}')">
                <img src="{{ 'customer-review-photo-1.jpg' | asset_url }}" alt="Customer photo 1" loading="lazy">
              </div>
              <div class="hb-reviews-thumb-item" onclick="openHbReviewsLightbox('{{ 'customer-review-photo-2.jpg' | asset_url }}')">
                <img src="{{ 'customer-review-photo-2.jpg' | asset_url }}" alt="Customer photo 2" loading="lazy">
              </div>
              <div class="hb-reviews-thumb-item" onclick="openHbReviewsLightbox('{{ 'customer-review-photo-3.jpg' | asset_url }}')">
                <img src="{{ 'customer-review-photo-3.jpg' | asset_url }}" alt="Customer photo 3" loading="lazy">
              </div>
            {%- endif -%}
          </div>
        {% endif %}
      </div>

      <div class="hb-reviews-header-right">
        {% if section.settings.button_text != blank %}
          <button type="button" class="hb-reviews-write-btn" id="hb-btn-write-{{ section.id }}">
            {{ section.settings.button_text }}
          </button>
        {% endif %}

        {% if section.settings.show_filter_sort %}
          <div style="position: relative;">
            <button type="button" class="hb-icon-btn" id="hb-filter-btn-{{ section.id }}" title="Filter reviews">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
            </button>
            <div class="hb-dropdown-menu" id="hb-filter-menu-{{ section.id }}">
              <button type="button" class="hb-dropdown-item" onclick="filterHbReviews('{{ section.id }}', 'all')">All Reviews</button>
              <button type="button" class="hb-dropdown-item" onclick="filterHbReviews('{{ section.id }}', '5')">5 Stars Only</button>
              <button type="button" class="hb-dropdown-item" onclick="filterHbReviews('{{ section.id }}', 'photos')">With Photos</button>
            </div>
          </div>

          <div style="position: relative;">
            <button type="button" class="hb-icon-btn" id="hb-sort-btn-{{ section.id }}" title="Sort reviews">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 15l5 5 5-5M7 9l5-5 5 5"/></svg>
            </button>
            <div class="hb-dropdown-menu" id="hb-sort-menu-{{ section.id }}">
              <button type="button" class="hb-dropdown-item" onclick="sortHbReviews('{{ section.id }}', 'newest')">Most Recent</button>
              <button type="button" class="hb-dropdown-item" onclick="sortHbReviews('{{ section.id }}', 'highest')">Highest Rating</button>
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    {% assign review_blocks = section.blocks | where: "type", "review_card" %}
    <div class="hb-reviews-grid" id="hb-reviews-grid-{{ section.id }}">
      {% for block in review_blocks %}
        <div class="hb-review-card" data-rating="{{ block.settings.rating | default: 5 }}" data-has-photo="{% if block.settings.reviewer_photo != blank or block.settings.fallback_photo != 'none' %}true{% else %}false{% endif %}" data-review-id="block_{{ block.id }}" {{ block.shopify_attributes }}>
          <!-- 1. Review Stars -->
          <div class="hb-review-stars">
            {%- assign star_count = block.settings.rating | default: 5 -%}
            {% for i in (1..star_count) %}
              <svg width="18" height="18" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            {% endfor %}
          </div>

          <!-- 2. Reviewer Name -->
          <div class="hb-review-author-wrap">
            <span class="hb-review-author">{{ block.settings.reviewer_name }}</span>
            <span class="hb-review-verified">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Verified
            </span>
          </div>

          <!-- 3. Date -->
          {% if block.settings.review_date != blank %}
            <div class="hb-review-date">{{ block.settings.review_date }}</div>
          {% endif %}

          <!-- 4. Review Content -->
          <div class="hb-review-body">
            <p>{{ block.settings.review_text }}</p>
          </div>

          <!-- 5. Customer Photo at Bottom Left -->
          {%- assign card_img = block.settings.reviewer_photo -%}
          {%- if card_img != blank -%}
            <div class="hb-review-photo-wrapper">
              <div class="hb-review-photo-link" onclick="openHbReviewsLightbox('{{ card_img | image_url: width: 1000 }}')">
                {{ card_img | image_url: width: 200 | image_tag: loading: 'lazy', class: 'hb-review-photo', alt: block.settings.reviewer_name }}
              </div>
            </div>
          {%- elsif block.settings.fallback_photo != 'none' -%}
            {%- capture card_fallback -%}customer-review-photo-{{ forloop.index | default: 1 }}.jpg{%- endcapture -%}
            <div class="hb-review-photo-wrapper">
              <div class="hb-review-photo-link" onclick="openHbReviewsLightbox('{{ card_fallback | asset_url }}')">
                <img src="{{ card_fallback | asset_url }}" class="hb-review-photo" alt="{{ block.settings.reviewer_name }} photo" loading="lazy">
              </div>
            </div>
          {%- endif -%}
        </div>
      {% endfor %}
    </div>

    {% for block in section.blocks %}
      {% if block.type == '@app' %}
        <div class="hb-reviews-app-slot" {{ block.shopify_attributes }}>
          {% render block %}
        </div>
      {% endif %}
    {% endfor %}
  </div>

  <!-- WRITE A REVIEW MODAL -->
  <div class="hb-modal-overlay" id="hb-modal-{{ section.id }}">
    <div class="hb-modal-box">
      <button type="button" class="hb-modal-close" aria-label="Close" onclick="closeHbWriteModal('{{ section.id }}')">&times;</button>
      
      <div id="hb-form-body-{{ section.id }}">
        <h3 class="hb-form-title">Write a Review</h3>

        <!-- Star Rating Picker -->
        <div class="hb-form-group">
          <label class="hb-form-label">Overall Rating *</label>
          <div class="hb-form-stars" id="hb-star-picker-{{ section.id }}">
            {% for s in (1..5) %}
              <button type="button" class="hb-form-star-btn active" data-val="{{ s }}" aria-label="{{ s }} stars">
                <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </button>
            {% endfor %}
          </div>
          <input type="hidden" id="hb-rating-val-{{ section.id }}" value="5">
        </div>

        <!-- Reviewer Name -->
        <div class="hb-form-group">
          <label class="hb-form-label" for="hb-input-name-{{ section.id }}">Your Name *</label>
          <input type="text" id="hb-input-name-{{ section.id }}" class="hb-form-input" placeholder="e.g. Sana or Ali" required>
        </div>

        <!-- Reviewer Email -->
        <div class="hb-form-group">
          <label class="hb-form-label" for="hb-input-email-{{ section.id }}">Email Address *</label>
          <input type="email" id="hb-input-email-{{ section.id }}" class="hb-form-input" placeholder="your@email.com" required>
        </div>

        <!-- Review Comments -->
        <div class="hb-form-group">
          <label class="hb-form-label" for="hb-input-text-{{ section.id }}">Review Comments *</label>
          <textarea id="hb-input-text-{{ section.id }}" class="hb-form-textarea" placeholder="How did this product help you?" required></textarea>
        </div>

        <!-- Photo Upload -->
        <div class="hb-form-group">
          <label class="hb-form-label">Add Photos (Optional)</label>
          <label class="hb-file-upload-area" for="hb-photo-input-{{ section.id }}">
            <svg class="hb-file-upload-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            <div style="font-size: 13.5px; font-weight: 600; color: #374151;">Click to Upload or Drag Photos Here</div>
            <div style="font-size: 12px; color: #6b7280; margin-top: 2px;">PNG, JPG up to 10MB</div>
            <input type="file" id="hb-photo-input-{{ section.id }}" accept="image/*">
          </label>
          <div class="hb-upload-preview" id="hb-preview-{{ section.id }}"></div>
        </div>

        <!-- Submit Button -->
        <button type="button" class="hb-form-submit-btn" id="hb-submit-btn-{{ section.id }}">Submit Review</button>
      </div>

      <!-- Success Confirmation -->
      <div id="hb-form-done-{{ section.id }}" class="hb-form-success">
        <div class="hb-form-success-icon">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </div>
        <h3 style="font-size: 20px; font-weight: 700; color: #111827; margin: 0 0 8px;">Review Submitted!</h3>
        <p style="font-size: 14px; color: #4b5563; margin: 0 0 20px;">Thank you for your feedback! Your review has been submitted and added.</p>
        <button type="button" class="hb-form-submit-btn" style="width: auto; padding: 10px 28px;" onclick="closeHbWriteModal('{{ section.id }}')">Close</button>
      </div>
    </div>
  </div>

  <!-- LIGHTBOX MODAL FOR ENLARGED PHOTO -->
  <div class="hb-lightbox-overlay" id="hb-lightbox" onclick="closeHbReviewsLightbox()">
    <div style="position: relative;" onclick="event.stopPropagation();">
      <button type="button" class="hb-modal-close" style="top: -16px; right: -16px; background: #ffffff;" aria-label="Close" onclick="closeHbReviewsLightbox()">&times;</button>
      <img id="hb-lightbox-img" class="hb-lightbox-img" src="" alt="Enlarged review photo">
    </div>
  </div>
</section>

<script>
  (function() {
    var sectionId = '{{ section.id }}';
    var brandStarColor = '{{ brand_star_color }}';
    var shopDomain = '{{ default_shop_domain }}';
    var productId = '{{ current_prod_id }}';
    var storageKey = 'asar_saved_reviews_' + sectionId;

    var modal = document.getElementById('hb-modal-' + sectionId);
    var writeBtn = document.getElementById('hb-btn-write-' + sectionId);
    var submitBtn = document.getElementById('hb-submit-btn-' + sectionId);
    var starPicker = document.getElementById('hb-star-picker-' + sectionId);
    var ratingInput = document.getElementById('hb-rating-val-' + sectionId);
    var photoInput = document.getElementById('hb-photo-input-' + sectionId);
    var previewContainer = document.getElementById('hb-preview-' + sectionId);
    var uploadedPhotoData = '';
    var selectedFile = null;

    // Helper to upload image directly to Judge.me S3 storage via presigned data
    function uploadImageToJudgeme(file, shopDomain, callback) {
      if (!file) {
        return callback(null);
      }
      fetch('https://api.judge.me/api/v1/pictures/presigned_data?shop_domain=' + encodeURIComponent(shopDomain) + '&platform=shopify')
        .then(function(res) {
          if (!res.ok) throw new Error('Presigned fetch status: ' + res.status);
          return res.json();
        })
        .then(function(presigned) {
          if (!presigned || !presigned.url || !presigned.key_prefix) {
            throw new Error('Invalid presigned data');
          }
          var cleanName = (Date.now() + '_' + (file.name || 'photo.jpg')).replace(/[^a-z0-9-_.]/gi, '');
          var s3Key = presigned.key_prefix + cleanName;
          var s3FormData = new FormData();
          s3FormData.append('key', s3Key);
          if (presigned.fields) {
            for (var k in presigned.fields) {
              if (presigned.fields.hasOwnProperty(k)) {
                s3FormData.append(k, presigned.fields[k]);
              }
            }
          }
          s3FormData.append('file', file);

          return fetch(presigned.url, {
            method: 'POST',
            body: s3FormData
          }).then(function(s3Res) {
            if (!s3Res.ok && s3Res.status !== 201) {
              throw new Error('S3 upload status: ' + s3Res.status);
            }
            return s3Key;
          });
        })
        .then(function(s3Key) {
          callback(s3Key);
        })
        .catch(function(err) {
          console.warn('[Judge.me] S3 image upload notice:', err);
          callback(null);
        });
    }

    // HTML escape helper
    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/[&<>"']/g, function(m) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
      });
    }

    // Canvas image compressor (keeps localStorage and payload lightweight)
    function compressImageFile(file, callback) {
      var reader = new FileReader();
      reader.onload = function(e) {
        var img = new Image();
        img.onload = function() {
          var canvas = document.createElement('canvas');
          var maxDim = 800;
          var w = img.width;
          var h = img.height;
          if (w > maxDim || h > maxDim) {
            if (w > h) {
              h = Math.round((h * maxDim) / w);
              w = maxDim;
            } else {
              w = Math.round((w * maxDim) / h);
              h = maxDim;
            }
          }
          canvas.width = w;
          canvas.height = h;
          var ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, w, h);
          callback(canvas.toDataURL('image/jpeg', 0.82));
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    // Build Card DOM element
    function createCardElement(rev) {
      var card = document.createElement('div');
      card.className = 'hb-review-card';
      card.setAttribute('data-rating', rev.rating || 5);
      card.setAttribute('data-has-photo', rev.photo ? 'true' : 'false');
      if (rev.id) {
        card.setAttribute('data-review-id', rev.id);
      }

      var starsHtml = '';
      var count = parseInt(rev.rating, 10) || 5;
      for (var i = 0; i < count; i++) {
        starsHtml += '<svg width="18" height="18" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>';
      }

      var photoHtml = '';
      if (rev.photo) {
        photoHtml = '<div class="hb-review-photo-wrapper"><div class="hb-review-photo-link" onclick="openHbReviewsLightbox(\'' + rev.photo + '\')"><img src="' + rev.photo + '" class="hb-review-photo" alt="' + escapeHtml(rev.name) + ' photo" loading="lazy"></div></div>';
      }

      var verifiedHtml = '<span class="hb-review-verified"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> Verified</span>';

      card.innerHTML = 
        '<div class="hb-review-stars" style="color: ' + brandStarColor + ';">' + starsHtml + '</div>' +
        '<div class="hb-review-author-wrap"><span class="hb-review-author">' + escapeHtml(rev.name) + '</span>' + verifiedHtml + '</div>' +
        (rev.date ? '<div class="hb-review-date">' + escapeHtml(rev.date) + '</div>' : '') +
        '<div class="hb-review-body"><p>' + escapeHtml(rev.text) + '</p></div>' +
        photoHtml;

      return card;
    }

    // Add photo to header strip
    function addPhotoToHeaderStrip(photoUrl, name) {
      var strip = document.getElementById('hb-header-thumbs-' + sectionId);
      if (strip && photoUrl) {
        var thumb = document.createElement('div');
        thumb.className = 'hb-reviews-thumb-item';
        thumb.onclick = function() { openHbReviewsLightbox(photoUrl); };
        thumb.innerHTML = '<img src="' + photoUrl + '" alt="' + escapeHtml(name) + ' review photo" loading="lazy">';
        strip.insertBefore(thumb, strip.firstChild);
      }
    }

    // Update rating score and count text in header
    function updateHeaderStats(scoreVal, totalCount) {
      var scoreEl = document.getElementById('hb-summary-score-' + sectionId);
      var countEl = document.getElementById('hb-summary-count-' + sectionId);
      if (scoreEl && scoreVal) {
        scoreEl.textContent = parseFloat(scoreVal).toFixed(1);
      }
      if (countEl && totalCount !== undefined) {
        countEl.textContent = totalCount + (totalCount === 1 ? ' review' : ' reviews');
      }
    }

    // ==========================================
    // EXTRACT REAL REVIEWS FROM JUDGE.ME
    // ==========================================
    function extractJudgemeReviews() {
      var list = [];
      var seenKeys = {};

      function addReview(rev) {
        if (!rev || !rev.name) return;
        var rName = rev.name.trim();
        var rText = (rev.text || '').trim();
        if (rName.toLowerCase().indexOf('test') === 0) {
          return;
        }
        var dedupeKey = rName.toLowerCase() + '_' + rText.toLowerCase().substring(0, 30);
        if (seenKeys[dedupeKey]) {
          if (rev.photo && !seenKeys[dedupeKey].photo) {
            seenKeys[dedupeKey].photo = rev.photo;
          }
          return;
        }
        seenKeys[dedupeKey] = rev;
        list.push(rev);
      }

      // 1. PRIMARY: Parse from SSR DOM .jdgm-rev elements (contains all live reviews rendered by Judge.me)
      var revEls = document.querySelectorAll('.jdgm-rev');
      revEls.forEach(function(el, idx) {
        var nameEl = el.querySelector('.jdgm-rev__author');
        var ratingEl = el.querySelector('.jdgm-rev__rating');
        var dateEl = el.querySelector('time.jdgm-rev__timestamp');
        var bodyEl = el.querySelector('.jdgm-rev__body');
        var picEl = el.querySelector('.jdgm-rev__pic-link') || el.querySelector('.jdgm-rev__pic-img');

        var rName = nameEl ? nameEl.textContent.trim() : 'Customer';
        var rText = bodyEl ? bodyEl.textContent.trim() : '';

        var rScore = 5;
        if (ratingEl && ratingEl.getAttribute('data-score')) {
          rScore = parseInt(ratingEl.getAttribute('data-score'), 10) || 5;
        }
        var rDate = '';
        if (dateEl) {
          var dt = dateEl.getAttribute('datetime') || dateEl.getAttribute('data-content');
          if (dt) {
            var d = new Date(dt);
            if (!isNaN(d.getTime())) {
              rDate = ('0' + (d.getMonth() + 1)).slice(-2) + '/' + ('0' + d.getDate()).slice(-2) + '/' + d.getFullYear();
            }
          }
        }
        var rPhoto = '';
        if (picEl) {
          rPhoto = picEl.getAttribute('href') || picEl.getAttribute('data-src') || picEl.getAttribute('src') || '';
        }

        addReview({
          id: el.getAttribute('data-review-id') || ('jdgm_dom_' + idx),
          name: rName,
          rating: rScore,
          date: rDate,
          text: rText,
          photo: rPhoto,
          verified: true
        });
      });

      // 2. ALSO check Judge.me server JSON-LD for any reviews with photos
      var jldScripts = document.querySelectorAll('script.jdgm-server-jld');
      jldScripts.forEach(function(sc) {
        try {
          var data = JSON.parse(sc.textContent);
          if (data && data.review && Array.isArray(data.review)) {
            data.review.forEach(function(r, idx) {
              var photos = [];
              if (r.image && Array.isArray(r.image)) {
                photos = r.image;
              } else if (typeof r.image === 'string' && r.image) {
                photos = [r.image];
              }
              var dStr = '';
              if (r.datePublished) {
                var d = new Date(r.datePublished);
                if (!isNaN(d.getTime())) {
                  dStr = ('0' + (d.getMonth() + 1)).slice(-2) + '/' + ('0' + d.getDate()).slice(-2) + '/' + d.getFullYear();
                } else {
                  dStr = r.datePublished;
                }
              }
              var ratingVal = 5;
              if (r.reviewRating && r.reviewRating.ratingValue) {
                ratingVal = parseInt(r.reviewRating.ratingValue, 10) || 5;
              }
              var revName = (r.author && r.author.name) ? r.author.name : 'Customer';
              var revBody = r.reviewBody || '';

              addReview({
                id: 'jdgm_jld_' + (idx + 1),
                name: revName,
                rating: ratingVal,
                date: dStr,
                text: revBody,
                photo: photos.length > 0 ? photos[0] : '',
                verified: true
              });
            });
          }
        } catch(e) {}
      });

      return list;
    }

    // ==========================================
    // SYNC AND RENDER ALL REVIEWS (JUDGE.ME + BLOCKS + SAVED)
    // ==========================================
    function syncAndRenderReviews() {
      var grid = document.getElementById('hb-reviews-grid-' + sectionId);
      if (!grid) return;

      var jdgmList = extractJudgemeReviews();

      // Read local storage saved reviews
      var savedList = [];
      try {
        savedList = JSON.parse(localStorage.getItem(storageKey) || '[]');
      } catch(e) { savedList = []; }

      // Read existing block cards
      var existingBlockCards = Array.from(grid.querySelectorAll('.hb-review-card[data-review-id^="block_"]'));

      // If Judge.me reviews exist, prepend them before blocks
      if (jdgmList.length > 0) {
        // Clear only non-block cards first
        var nonBlockCards = grid.querySelectorAll('.hb-review-card:not([data-review-id^="block_"])');
        nonBlockCards.forEach(function(c) { c.remove(); });

        // Insert Judge.me reviews in order
        jdgmList.forEach(function(rev) {
          if (!grid.querySelector('[data-review-id="' + rev.id + '"]')) {
            var card = createCardElement(rev);
            // Insert before blocks
            if (existingBlockCards.length > 0) {
              grid.insertBefore(card, existingBlockCards[0]);
            } else {
              grid.appendChild(card);
            }
          }
        });
      }

      // Merge locally submitted user reviews (preserve photos across refreshes)
      if (savedList && savedList.length > 0) {
        var updatedSavedList = [];
        for (var i = savedList.length - 1; i >= 0; i--) {
          var sRev = savedList[i];
          if (!sRev || !sRev.name) continue;

          var matchingJdgm = null;
          for (var j = 0; j < jdgmList.length; j++) {
            if ((jdgmList[j].name || '').trim().toLowerCase() === (sRev.name || '').trim().toLowerCase() &&
                (jdgmList[j].text || '').trim().toLowerCase() === (sRev.text || '').trim().toLowerCase()) {
              matchingJdgm = jdgmList[j];
              break;
            }
          }

          if (matchingJdgm) {
            // Review exists in Judge.me
            if (sRev.photo && !matchingJdgm.photo) {
              // Judge.me has the text but hasn't published the photo yet -> attach photo to the card!
              matchingJdgm.photo = sRev.photo;
              var card = grid.querySelector('[data-review-id="' + matchingJdgm.id + '"]');
              if (card && !card.querySelector('.hb-review-photo')) {
                var pWrap = document.createElement('div');
                pWrap.className = 'hb-review-photo-wrapper';
                pWrap.innerHTML = '<div class="hb-review-photo-link" onclick="openHbReviewsLightbox(\'' + sRev.photo + '\')"><img src="' + sRev.photo + '" class="hb-review-photo" alt="' + escapeHtml(matchingJdgm.name) + ' photo" loading="lazy"></div>';
                card.appendChild(pWrap);
                card.setAttribute('data-has-photo', 'true');
              }
              // Keep in localStorage so the photo does not vanish on refresh while Judge.me processes it
              updatedSavedList.unshift(sRev);
            }
          } else {
            // Not yet in Judge.me SSR HTML -> Prepend as standalone card
            if (!grid.querySelector('[data-review-id="' + sRev.id + '"]')) {
              var sCard = createCardElement(sRev);
              grid.insertBefore(sCard, grid.firstChild);
            }
            updatedSavedList.unshift(sRev);
          }
        }

        try {
          localStorage.setItem(storageKey, JSON.stringify(updatedSavedList));
        } catch(e) {}
      }

      // Sync photos into header thumbnail strip
      var strip = document.getElementById('hb-header-thumbs-' + sectionId);
      if (strip) {
        var allCards = grid.querySelectorAll('.hb-review-card');
        var seenPhotos = [];
        allCards.forEach(function(c) {
          var img = c.querySelector('.hb-review-photo');
          if (img && img.src && !seenPhotos.includes(img.src)) {
            seenPhotos.push({
              url: img.src,
              name: (c.querySelector('.hb-review-author') ? c.querySelector('.hb-review-author').textContent.trim() : 'Customer')
            });
          }
        });

        if (seenPhotos.length > 0) {
          strip.innerHTML = '';
          seenPhotos.forEach(function(p) {
            var thumb = document.createElement('div');
            thumb.className = 'hb-reviews-thumb-item';
            thumb.onclick = function() { openHbReviewsLightbox(p.url); };
            thumb.innerHTML = '<img src="' + p.url + '" alt="' + escapeHtml(p.name) + ' review photo" loading="lazy">';
            strip.appendChild(thumb);
          });
        }
      }

      // Calculate total count and score
      var totalCards = grid.querySelectorAll('.hb-review-card').length;
      if (totalCards > 0) {
        var totalRating = 0;
        grid.querySelectorAll('.hb-review-card').forEach(function(c) {
          totalRating += parseInt(c.getAttribute('data-rating') || 5, 10);
        });
        var avg = (totalRating / totalCards).toFixed(1);
        updateHeaderStats(avg, totalCards);
      }
    }

    // Run sync on load and after DOM is ready
    syncAndRenderReviews();
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncAndRenderReviews);
    }
    // Also run on window load to catch any dynamically injected Judge.me assets
    window.addEventListener('load', syncAndRenderReviews);

    // Open Write Modal
    if (writeBtn && modal) {
      writeBtn.addEventListener('click', function(e) {
        e.preventDefault();
        var formBody = document.getElementById('hb-form-body-' + sectionId);
        var formDone = document.getElementById('hb-form-done-' + sectionId);
        if (formBody) formBody.style.display = 'block';
        if (formDone) formDone.style.display = 'none';
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      });
    }

    // Close modal function
    window.closeHbWriteModal = function(id) {
      var m = document.getElementById('hb-modal-' + id);
      if (m) {
        m.classList.remove('active');
        document.body.style.overflow = '';
        var formBody = document.getElementById('hb-form-body-' + id);
        var formDone = document.getElementById('hb-form-done-' + id);
        if (formBody) formBody.style.display = 'block';
        if (formDone) formDone.style.display = 'none';
      }
    };

    // Close on overlay click
    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === modal) {
          closeHbWriteModal(sectionId);
        }
      });
    }

    // Star Picker Interaction
    if (starPicker) {
      var starBtns = starPicker.querySelectorAll('.hb-form-star-btn');
      starBtns.forEach(function(btn) {
        btn.addEventListener('mouseenter', function() {
          var hoverVal = parseInt(this.getAttribute('data-val'), 10);
          starBtns.forEach(function(b) {
            var bVal = parseInt(b.getAttribute('data-val'), 10);
            if (bVal <= hoverVal) {
              b.classList.add('hover');
            } else {
              b.classList.remove('hover');
            }
          });
        });

        btn.addEventListener('click', function() {
          var clickVal = parseInt(this.getAttribute('data-val'), 10);
          ratingInput.value = clickVal;
          starBtns.forEach(function(b) {
            var bVal = parseInt(b.getAttribute('data-val'), 10);
            if (bVal <= clickVal) {
              b.classList.add('active');
            } else {
              b.classList.remove('active');
            }
          });
        });
      });

      starPicker.addEventListener('mouseleave', function() {
        starBtns.forEach(function(b) {
          b.classList.remove('hover');
        });
      });
    }

    // Photo Input Preview via FileReader with Canvas compression
    if (photoInput) {
      photoInput.addEventListener('change', function() {
        var file = this.files[0];
        if (file) {
          selectedFile = file;
          compressImageFile(file, function(compressedData) {
            uploadedPhotoData = compressedData;
            if (previewContainer) {
              previewContainer.innerHTML = '<img src="' + uploadedPhotoData + '" alt="Upload preview">';
              previewContainer.style.display = 'flex';
            }
          });
        } else {
          selectedFile = null;
          uploadedPhotoData = '';
          if (previewContainer) {
            previewContainer.innerHTML = '';
            previewContainer.style.display = 'none';
          }
        }
      });
    }

    // ==========================================
    // REAL REVIEW SUBMISSION TO JUDGE.ME & DOM
    // ==========================================
    if (submitBtn) {
      submitBtn.addEventListener('click', function() {
        var nameInput = document.getElementById('hb-input-name-' + sectionId);
        var emailInput = document.getElementById('hb-input-email-' + sectionId);
        var textInput = document.getElementById('hb-input-text-' + sectionId);

        var nameVal = nameInput.value.trim();
        var emailVal = emailInput.value.trim();
        var textVal = textInput.value.trim();

        if (!nameVal) {
          alert('Please enter your name.');
          nameInput.focus();
          return;
        }
        if (!emailVal || !emailVal.includes('@')) {
          alert('Please enter a valid email address.');
          emailInput.focus();
          return;
        }
        if (!textVal) {
          alert('Please write your review comment.');
          textInput.focus();
          return;
        }

        var starVal = parseInt(ratingInput.value, 10) || 5;
        var today = new Date();
        var dateFormatted = ('0' + (today.getMonth() + 1)).slice(-2) + '/' + ('0' + today.getDate()).slice(-2) + '/' + today.getFullYear();

        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting Review...';

        uploadImageToJudgeme(selectedFile, shopDomain, function(s3Key) {
          // Prepare FormData for Judge.me Official API
          var formData = new FormData();
          formData.append('shop_domain', shopDomain);
          formData.append('platform', 'shopify');
          formData.append('id', productId);
          formData.append('name', nameVal);
          formData.append('email', emailVal);
          formData.append('rating', starVal);
          formData.append('body', textVal);

          if (s3Key) {
            formData.append('picture_keys[0]', s3Key);
          }

          // Post to Judge.me API in background
          fetch('https://judge.me/api/v1/reviews', {
            method: 'POST',
            body: formData
          })
          .then(function(res) {
            return res.json().catch(function() { return {}; });
          })
          .then(function(resData) {
            console.log('[Judge.me] Review submission response:', resData);
            completeSubmission();
          })
          .catch(function(err) {
            console.warn('[Judge.me] Review submission notice:', err);
            completeSubmission();
          });
        });

        function completeSubmission() {
          var reviewObj = {
            id: 'rev_' + Date.now(),
            name: nameVal,
            rating: starVal,
            date: dateFormatted,
            text: textVal,
            photo: uploadedPhotoData || ''
          };

          // 1. Save to LocalStorage so customer retains it on refresh
          var savedList = [];
          try {
            savedList = JSON.parse(localStorage.getItem(storageKey) || '[]');
          } catch(e) { savedList = []; }
          savedList.unshift(reviewObj);
          try {
            localStorage.setItem(storageKey, JSON.stringify(savedList));
          } catch(e) {}

          // 2. Prepend card to grid
          var grid = document.getElementById('hb-reviews-grid-' + sectionId);
          if (grid) {
            var card = createCardElement(reviewObj);
            grid.insertBefore(card, grid.firstChild);
          }

          // 3. Add to Header photo strip
          if (reviewObj.photo) {
            addPhotoToHeaderStrip(reviewObj.photo, reviewObj.name);
          }

          // 4. Update Header review count
          var allCardsCount = grid ? grid.querySelectorAll('.hb-review-card').length : 1;
          updateHeaderStats('5.0', allCardsCount);

          // 5. Show Success View
          var formBody = document.getElementById('hb-form-body-' + sectionId);
          var formDone = document.getElementById('hb-form-done-' + sectionId);
          if (formBody && formDone) {
            formBody.style.display = 'none';
            formDone.style.display = 'block';
          }

          // 6. Reset Form
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit Review';
          nameInput.value = '';
          emailInput.value = '';
          textInput.value = '';
          uploadedPhotoData = '';
          if (photoInput) photoInput.value = '';
          if (previewContainer) {
            previewContainer.innerHTML = '';
            previewContainer.style.display = 'none';
          }
        }
      });
    }

    // Filter & Sort Dropdown Toggles
    var filterBtn = document.getElementById('hb-filter-btn-' + sectionId);
    var filterMenu = document.getElementById('hb-filter-menu-' + sectionId);
    var sortBtn = document.getElementById('hb-sort-btn-' + sectionId);
    var sortMenu = document.getElementById('hb-sort-menu-' + sectionId);

    if (filterBtn && filterMenu) {
      filterBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        if (sortMenu) sortMenu.classList.remove('active');
        filterMenu.classList.toggle('active');
      });
    }

    if (sortBtn && sortMenu) {
      sortBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        if (filterMenu) filterMenu.classList.remove('active');
        sortMenu.classList.toggle('active');
      });
    }

    document.addEventListener('click', function() {
      if (filterMenu) filterMenu.classList.remove('active');
      if (sortMenu) sortMenu.classList.remove('active');
    });

    // Filter Function
    window.filterHbReviews = function(secId, type) {
      var g = document.getElementById('hb-reviews-grid-' + secId);
      if (!g) return;
      var cards = g.querySelectorAll('.hb-review-card');
      cards.forEach(function(c) {
        if (type === 'all') {
          c.style.display = 'flex';
        } else if (type === '5') {
          c.style.display = (c.getAttribute('data-rating') === '5') ? 'flex' : 'none';
        } else if (type === 'photos') {
          c.style.display = (c.getAttribute('data-has-photo') === 'true') ? 'flex' : 'none';
        }
      });
    };

    // Sort Function
    window.sortHbReviews = function(secId, sortType) {
      var g = document.getElementById('hb-reviews-grid-' + secId);
      if (!g) return;
      var cards = Array.from(g.querySelectorAll('.hb-review-card'));
      if (sortType === 'highest') {
        cards.sort(function(a, b) {
          return parseInt(b.getAttribute('data-rating'), 10) - parseInt(a.getAttribute('data-rating'), 10);
        });
      } else {
        // Reverse for newest
        cards.reverse();
      }
      cards.forEach(function(c) { g.appendChild(c); });
    };

    // Global Lightbox Functions
    window.openHbReviewsLightbox = function(src) {
      var lb = document.getElementById('hb-lightbox');
      var img = document.getElementById('hb-lightbox-img');
      if (lb && img) {
        img.src = src;
        lb.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    };

    window.closeHbReviewsLightbox = function() {
      var lb = document.getElementById('hb-lightbox');
      if (lb) {
        lb.classList.remove('active');
        document.body.style.overflow = '';
      }
    };
  })();
</script>

