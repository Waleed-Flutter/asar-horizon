{{ 'horizon-botanical.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding: 0 !important;
    background-color: {{ section.settings.background_color | default: '#ffffff' }} !important;
  }

  #shopify-section-{{ section.id }} .hb-routine-section {
    background-color: {{ section.settings.background_color | default: '#ffffff' }} !important;
    padding-top: {{ section.settings.padding_top | default: 88 }}px !important;
    padding-bottom: {{ section.settings.padding_bottom | default: 88 }}px !important;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .hb-routine-section {
      padding-top: {{ section.settings.padding_top | default: 88 | times: 0.65 | round }}px !important;
      padding-bottom: {{ section.settings.padding_bottom | default: 88 | times: 0.65 | round }}px !important;
    }
  }

  #shopify-section-{{ section.id }} .hb-section-header .hb-eyebrow {
    color: {{ section.settings.eyebrow_color | default: '#257942' }};
    font-size: {{ section.settings.eyebrow_size | default: 13 }}px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .hb-section-header h2 {
    color: {{ section.settings.heading_color | default: '#111827' }};
    font-size: {{ section.settings.heading_size | default: 40 }}px;
    line-height: 1.2;
    margin: 0 0 12px;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .hb-section-header h2 {
      font-size: {{ section.settings.heading_size_mobile | default: 28 }}px;
    }
  }

  #shopify-section-{{ section.id }} .hb-section-header p {
    color: {{ section.settings.subheading_color | default: '#4b5563' }};
    font-size: {{ section.settings.subheading_size | default: 16 }}px;
    line-height: 1.6;
    max-width: 680px;
    margin: 0 auto;
  }

  /* Routine Cards */
  #shopify-section-{{ section.id }} .hb-routine-card {
    background-color: {{ section.settings.card_bg | default: '#ffffff' }};
    border-radius: {{ section.settings.card_radius | default: 16 }}px;
    border: 1px solid {{ section.settings.card_border_color | default: '#e5e7eb' }};
    {% if section.settings.card_shadow %}
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
    {% else %}
      box-shadow: none;
    {% endif %}
    overflow: hidden;
    transition: all 0.3s ease;
  }

  #shopify-section-{{ section.id }} .hb-routine-card:hover {
    transform: translateY(-4px);
    border-color: {{ section.settings.card_hover_border_color | default: '#257942' }};
    {% if section.settings.card_shadow %}
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    {% endif %}
  }

  {% unless section.settings.img_hover_zoom %}
    #shopify-section-{{ section.id }} .hb-routine-card:hover .hb-routine-img img {
      transform: none !important;
    }
  {% endunless %}

  #shopify-section-{{ section.id }} .hb-routine-step-num {
    color: {{ section.settings.step_num_color | default: '#257942' }};
    font-size: {{ section.settings.step_num_size | default: 14 }}px;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  #shopify-section-{{ section.id }} .hb-routine-title {
    color: {{ section.settings.step_title_color | default: '#111827' }};
    font-size: {{ section.settings.step_title_size | default: 18 }}px;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .hb-routine-desc {
    color: {{ section.settings.step_desc_color | default: '#4b5563' }};
    font-size: {{ section.settings.step_desc_size | default: 14 }}px;
    line-height: 1.55;
  }

  /* Trust Bar */
  #shopify-section-{{ section.id }} .hb-routine-trust-bar {
    background-color: {{ section.settings.trust_bar_bg | default: '#e8f5e9' }};
    border-radius: {{ section.settings.trust_bar_radius | default: 50 }}px;
  }

  #shopify-section-{{ section.id }} .hb-routine-trust-item {
    color: {{ section.settings.trust_bar_color | default: '#1b5e20' }};
    font-size: {{ section.settings.trust_bar_size | default: 14 }}px;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .hb-routine-trust-item svg {
    color: {{ section.settings.trust_bar_icon_color | default: '#257942' }};
    stroke: currentColor;
  }
{%- endstyle -%}

<section class="hb-routine-section" id="routine" style="background-color: {{ section.settings.background_color | default: '#ffffff' }}; padding-top: {{ section.settings.padding_top | default: 88 }}px; padding-bottom: {{ section.settings.padding_bottom | default: 88 }}px;">
  <div class=hb-container>
    {% if section.settings.heading != blank or section.settings.eyebrow != blank %}
      <div class=hb-section-header>
        {% if section.settings.eyebrow != blank %}
          <span class=hb-eyebrow>{{ section.settings.eyebrow }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p>{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class=hb-routine-grid>
      {% for block in section.blocks %}
        {% if block.type == 'step' %}
          {%- assign blk_num_color = block.settings.custom_step_color | default: section.settings.step_num_color | default: '#257942' -%}
          {%- assign blk_title_color = block.settings.custom_title_color | default: section.settings.step_title_color | default: '#111827' -%}
          <div class=hb-routine-card {{ block.shopify_attributes }}>
            <div class=hb-routine-body>
              {% if block.settings.step_number != blank %}
                <span class=hb-routine-step-num style="color: {{ blk_num_color }};">{{ block.settings.step_number }}</span>
              {% endif %}
              {% if block.settings.title != blank %}
                <h3 class=hb-routine-title style="color: {{ blk_title_color }};">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class=hb-routine-desc>{{ block.settings.description }}</p>
              {% endif %}
            </div>
            <div class=hb-routine-img>
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.title, width: 400, height: 400 }}
              {% elsif block.settings.fallback_image != blank %}
                <img src="{{ block.settings.fallback_image | asset_url }}" alt="{{ block.settings.title | escape }}" width="400" height="400" loading="lazy">
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.show_trust_bar %}
      {% assign trust_points = section.blocks | where: "type", "trust_point" %}
      {% if trust_points.size > 0 %}
        <div class=hb-routine-trust-bar>
          {% for block in trust_points %}
            {%- assign item_text_color = block.settings.custom_color | default: section.settings.trust_bar_color | default: '#1b5e20' -%}
            {%- assign item_icon_color = block.settings.custom_icon_color | default: section.settings.trust_bar_icon_color | default: '#257942' -%}
            <div class=hb-routine-trust-item style="color: {{ item_text_color }};" {{ block.shopify_attributes }}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="color: {{ item_icon_color }};"><polyline points="20 6 9 17 4 12"/></svg>
              <span>{{ block.settings.text }}</span>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}
  </div>
</section>

