{{ 'horizon-botanical.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding: 0 !important;
    background-color: {{ section.settings.background_color | default: '#ffffff' }} !important;
  }

  #shopify-section-{{ section.id }} .hb-routine-section {
    background-color: {{ section.settings.background_color | default: '#ffffff' }} !important;
    padding-top: {{ section.settings.padding_top | default: 80 }}px !important;
    padding-bottom: {{ section.settings.padding_bottom | default: 84 }}px !important;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .hb-routine-section {
      padding-top: {{ section.settings.padding_top | default: 80 | times: 0.65 | round }}px !important;
      padding-bottom: {{ section.settings.padding_bottom | default: 84 | times: 0.65 | round }}px !important;
    }
  }

  #shopify-section-{{ section.id }} .hb-section-header .hb-eyebrow {
    color: {{ section.settings.eyebrow_color | default: '#257942' }};
    font-size: {{ section.settings.eyebrow_size | default: 13 }}px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    margin-bottom: 12px;
    display: inline-block;
  }

  #shopify-section-{{ section.id }} .hb-section-header h2 {
    color: {{ section.settings.heading_color | default: '#111827' }};
    font-size: {{ section.settings.heading_size | default: 40 }}px;
    line-height: 1.2;
    margin: 0;
    font-weight: 800;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .hb-section-header h2 {
      font-size: {{ section.settings.heading_size_mobile | default: 28 }}px;
    }
  }

  #shopify-section-{{ section.id }} .hb-section-header p {
    color: {{ section.settings.subheading_color | default: '#4b5563' }};
    font-size: {{ section.settings.subheading_size | default: 16 }}px;
    line-height: 1.6;
    max-width: 680px;
    margin: 12px auto 0;
  }

  /* Routine Grid */
  #shopify-section-{{ section.id }} .hb-routine-grid {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr) !important;
    gap: 24px !important;
    margin-top: 48px !important;
    align-items: stretch !important;
  }

  /* Routine Horizontal Card */
  #shopify-section-{{ section.id }} .hb-routine-card {
    display: flex !important;
    flex-direction: row !important;
    align-items: stretch !important;
    justify-content: space-between !important;
    min-height: 165px !important;
    height: 100% !important;
    background-color: {{ section.settings.card_bg | default: '#f8f9fa' }} !important;
    border-radius: {{ section.settings.card_radius | default: 16 }}px !important;
    border: 1px solid {{ section.settings.card_border_color | default: '#eef0ee' }} !important;
    overflow: hidden !important;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
    {% if section.settings.card_shadow %}
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.03) !important;
    {% else %}
      box-shadow: none !important;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .hb-routine-card:hover {
    transform: translateY(-3px) !important;
    border-color: {{ section.settings.card_hover_border_color | default: '#257942' }} !important;
    {% if section.settings.card_shadow %}
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08) !important;
    {% endif %}
  }

  /* Left Side: Body & Typography */
  #shopify-section-{{ section.id }} .hb-routine-body {
    flex: 1 1 58% !important;
    padding: 24px 16px 24px 24px !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    text-align: left !important;
  }

  #shopify-section-{{ section.id }} .hb-routine-step-header {
    display: flex !important;
    align-items: baseline !important;
    gap: 8px !important;
    margin-bottom: 8px !important;
  }

  #shopify-section-{{ section.id }} .hb-routine-step-num {
    color: {{ section.settings.step_num_color | default: '#257942' }} !important;
    font-size: {{ section.settings.step_num_size | default: 13 }}px !important;
    font-weight: 800 !important;
    letter-spacing: 0.06em !important;
    text-transform: uppercase !important;
    line-height: 1 !important;
    flex-shrink: 0 !important;
  }

  #shopify-section-{{ section.id }} .hb-routine-step-title {
    color: {{ section.settings.step_title_color | default: '#111827' }} !important;
    font-size: {{ section.settings.step_title_size | default: 14 }}px !important;
    font-weight: 800 !important;
    letter-spacing: 0.06em !important;
    text-transform: uppercase !important;
    line-height: 1 !important;
    margin: 0 !important;
  }

  #shopify-section-{{ section.id }} .hb-routine-desc {
    color: {{ section.settings.step_desc_color | default: '#6b7280' }} !important;
    font-size: {{ section.settings.step_desc_size | default: 13 }}px !important;
    line-height: 1.45 !important;
    margin: 0 !important;
  }

  /* Right Side: Visual Image & Media */
  #shopify-section-{{ section.id }} .hb-routine-visual {
    flex: 0 0 42% !important;
    width: 42% !important;
    max-width: 44% !important;
    height: 100% !important;
    min-height: 100% !important;
    position: relative !important;
    overflow: hidden !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  #shopify-section-{{ section.id }} .hb-routine-visual--img {
    aspect-ratio: auto !important;
    background-color: #f7f9f7 !important;
  }

  #shopify-section-{{ section.id }} .hb-routine-visual img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    border-top-right-radius: inherit !important;
    border-bottom-right-radius: inherit !important;
    display: block !important;
    transition: transform 0.4s ease !important;
  }

  {% if section.settings.img_hover_zoom %}
    #shopify-section-{{ section.id }} .hb-routine-card:hover .hb-routine-visual img {
      transform: scale(1.06) !important;
    }
  {% endif %}

  /* Morning & Evening Badge Visual */
  #shopify-section-{{ section.id }} .hb-routine-badges-col {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 12px !important;
    width: 100% !important;
    height: 100% !important;
    padding: 12px !important;
    border-top-right-radius: inherit !important;
    border-bottom-right-radius: inherit !important;
  }

  #shopify-section-{{ section.id }} .hb-routine-badge-item {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    gap: 4px !important;
  }

  #shopify-section-{{ section.id }} .hb-routine-badge-label {
    font-size: 10px !important;
    font-weight: 700 !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
    color: {{ section.settings.step_num_color | default: '#257942' }} !important;
    line-height: 1 !important;
  }

  #shopify-section-{{ section.id }} .hb-routine-badge-circle {
    width: 42px !important;
    height: 42px !important;
    border-radius: 50% !important;
    border: 2px solid {{ section.settings.step_num_color | default: '#257942' }} !important;
    background-color: #ffffff !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: {{ section.settings.step_num_color | default: '#257942' }} !important;
    box-shadow: 0 2px 8px rgba(37, 121, 66, 0.08) !important;
    transition: all 0.25s ease !important;
  }

  #shopify-section-{{ section.id }} .hb-routine-card:hover .hb-routine-badge-circle {
    transform: scale(1.08) !important;
    border-color: {{ section.settings.card_hover_border_color | default: '#257942' }} !important;
  }

  #shopify-section-{{ section.id }} .hb-routine-badge-circle svg {
    width: 20px !important;
    height: 20px !important;
    stroke: currentColor !important;
  }

  /* Bottom Precautions Row */
  #shopify-section-{{ section.id }} .hb-routine-precautions {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 40px !important;
    margin-top: 48px !important;
    flex-wrap: wrap !important;
    padding: 0 16px !important;
  }

  #shopify-section-{{ section.id }} .hb-routine-precaution-item {
    display: flex !important;
    align-items: center !important;
    gap: 10px !important;
    font-size: {{ section.settings.trust_bar_size | default: 14 }}px !important;
    font-weight: 500 !important;
    color: {{ section.settings.trust_bar_color | default: '#4b5563' }} !important;
    line-height: 1.4 !important;
  }

  #shopify-section-{{ section.id }} .hb-routine-precaution-icon {
    width: 22px !important;
    height: 22px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: {{ section.settings.trust_bar_icon_color | default: '#257942' }} !important;
    flex-shrink: 0 !important;
  }

  #shopify-section-{{ section.id }} .hb-routine-precaution-icon svg {
    width: 20px !important;
    height: 20px !important;
    stroke: currentColor !important;
  }

  @media (max-width: 990px) {
    #shopify-section-{{ section.id }} .hb-routine-grid {
      grid-template-columns: 1fr !important;
      gap: 18px !important;
      max-width: 580px !important;
      margin-left: auto !important;
      margin-right: auto !important;
    }
    #shopify-section-{{ section.id }} .hb-routine-card {
      min-height: 145px !important;
    }
    #shopify-section-{{ section.id }} .hb-routine-precautions {
      gap: 24px !important;
      margin-top: 32px !important;
    }
  }

  @media (max-width: 540px) {
    #shopify-section-{{ section.id }} .hb-routine-body {
      padding: 16px 14px 16px 16px !important;
    }
    #shopify-section-{{ section.id }} .hb-routine-step-header {
      gap: 6px !important;
      margin-bottom: 6px !important;
    }
    #shopify-section-{{ section.id }} .hb-routine-desc {
      font-size: 12.5px !important;
    }
    #shopify-section-{{ section.id }} .hb-routine-precautions {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 12px !important;
      width: fit-content !important;
      margin: 28px auto 0 !important;
    }
  }
{%- endstyle -%}

<section class="hb-routine-section" id="routine" style="background-color: {{ section.settings.background_color | default: '#ffffff' }}; padding-top: {{ section.settings.padding_top | default: 80 }}px; padding-bottom: {{ section.settings.padding_bottom | default: 84 }}px;">
  <div class="hb-container">
    {% if section.settings.heading != blank or section.settings.eyebrow != blank %}
      <div class="hb-section-header">
        {% if section.settings.eyebrow != blank %}
          <span class="hb-eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p>{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="hb-routine-grid">
      {% for block in section.blocks %}
        {% if block.type == 'step' %}
          {%- assign blk_num_color = block.settings.custom_step_color | default: section.settings.step_num_color | default: '#257942' -%}
          {%- assign blk_title_color = block.settings.custom_title_color | default: section.settings.step_title_color | default: '#111827' -%}
          {%- assign step_display = block.settings.step_number | remove: 'STEP ' | remove: 'Step ' | remove: 'step ' -%}
          <div class="hb-routine-card" {{ block.shopify_attributes }}>
            <div class="hb-routine-body">
              <div class="hb-routine-step-header">
                {% if block.settings.step_number != blank %}
                  <span class="hb-routine-step-num" style="color: {{ blk_num_color }};">{{ step_display }}</span>
                {% endif %}
                {% if block.settings.title != blank %}
                  <span class="hb-routine-step-title" style="color: {{ blk_title_color }};">{{ block.settings.title }}</span>
                {% endif %}
              </div>
              {% if block.settings.description != blank %}
                <p class="hb-routine-desc">{{ block.settings.description }}</p>
              {% endif %}
            </div>

            {% if block.settings.visual_type == 'morning_evening' %}
              <div class="hb-routine-visual hb-routine-visual--badges">
                <div class="hb-routine-badges-col">
                  <div class="hb-routine-badge-item">
                    <span class="hb-routine-badge-label">{{ block.settings.morning_label | default: 'MORNING' }}</span>
                    <div class="hb-routine-badge-circle">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="5"></circle>
                        <line x1="12" y1="1" x2="12" y2="3"></line>
                        <line x1="12" y1="21" x2="12" y2="23"></line>
                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                        <line x1="1" y1="12" x2="3" y2="12"></line>
                        <line x1="21" y1="12" x2="23" y2="12"></line>
                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                      </svg>
                    </div>
                  </div>
                  <div class="hb-routine-badge-item">
                    <span class="hb-routine-badge-label">{{ block.settings.evening_label | default: 'EVENING' }}</span>
                    <div class="hb-routine-badge-circle">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                        <path d="M19 3v4"></path>
                        <path d="M21 5h-4"></path>
                      </svg>
                    </div>
                  </div>
                </div>
              </div>
            {% else %}
              <div class="hb-routine-visual hb-routine-visual--img">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.title, width: 260, height: 260 }}
                {% elsif block.settings.fallback_image != blank %}
                  <img src="{{ block.settings.fallback_image | asset_url }}" alt="{{ block.settings.title | escape }}" width="260" height="260" loading="lazy">
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.show_trust_bar %}
      {% assign trust_points = section.blocks | where: "type", "trust_point" %}
      <div class="hb-routine-precautions">
        {% if trust_points.size > 0 %}
          {% for block in trust_points %}
            {%- assign item_text_color = block.settings.custom_color | default: section.settings.trust_bar_color | default: '#4b5563' -%}
            {%- assign item_icon_color = block.settings.custom_icon_color | default: section.settings.trust_bar_icon_color | default: '#257942' -%}
            <div class="hb-routine-precaution-item" style="color: {{ item_text_color }};" {{ block.shopify_attributes }}>
              <span class="hb-routine-precaution-icon" style="color: {{ item_icon_color }};">
                {% case block.settings.icon %}
                  {% when 'target' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="1"/></svg>
                  {% when 'prohibited' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                  {% when 'check' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  {% when 'leaf' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {% endcase %}
              </span>
              <span>{{ block.settings.text }}</span>
            </div>
          {% endfor %}
        {% else %}
          <div class="hb-routine-precaution-item">
            <span class="hb-routine-precaution-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </span>
            <span>For external use only.</span>
          </div>
          <div class="hb-routine-precaution-item">
            <span class="hb-routine-precaution-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="1"/></svg>
            </span>
            <span>Patch test before first use.</span>
          </div>
          <div class="hb-routine-precaution-item">
            <span class="hb-routine-precaution-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
            </span>
            <span>Avoid eyes and broken skin.</span>
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Daily Routine Steps",
  "settings": [
    {
      "type": "header",
      "content": "Section Header & Typography"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "HOW TO USE"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#257942"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Eyebrow Font Size",
      "default": 13
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Simple Enough for Every Day."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111827"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size (Desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 20,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size (Mobile)",
      "default": 28
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading (Optional)",
      "default": ""
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#4b5563"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Subheading Font Size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Routine Step Cards"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background Color",
      "default": "#f8f9fa"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color",
      "default": "#eef0ee"
    },
    {
      "type": "color",
      "id": "card_hover_border_color",
      "label": "Card Hover Border Color",
      "default": "#257942"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "card_shadow",
      "label": "Enable Card Shadow",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "img_hover_zoom",
      "label": "Enable Image Hover Zoom",
      "default": true
    },
    {
      "type": "header",
      "content": "Step Typography & Colors"
    },
    {
      "type": "color",
      "id": "step_num_color",
      "label": "Step Number Color (e.g. 01)",
      "default": "#257942"
    },
    {
      "type": "range",
      "id": "step_num_size",
      "min": 11,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Step Number Font Size",
      "default": 13
    },
    {
      "type": "color",
      "id": "step_title_color",
      "label": "Step Title Color (e.g. APPLY)",
      "default": "#111827"
    },
    {
      "type": "range",
      "id": "step_title_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Step Title Font Size",
      "default": 14
    },
    {
      "type": "color",
      "id": "step_desc_color",
      "label": "Step Description Color",
      "default": "#6b7280"
    },
    {
      "type": "range",
      "id": "step_desc_size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Step Description Font Size",
      "default": 13
    },
    {
      "type": "header",
      "content": "Precautions / Safety Notes Bar"
    },
    {
      "type": "checkbox",
      "id": "show_trust_bar",
      "label": "Show Precautions / Safety Notes",
      "default": true
    },
    {
      "type": "color",
      "id": "trust_bar_color",
      "label": "Notes Text Color",
      "default": "#4b5563"
    },
    {
      "type": "color",
      "id": "trust_bar_icon_color",
      "label": "Notes Icon Color",
      "default": "#257942"
    },
    {
      "type": "range",
      "id": "trust_bar_size",
