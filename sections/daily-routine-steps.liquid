{{ 'horizon-botanical.css' | asset_url | stylesheet_tag }}

<section class="hb-routine-section" id="routine" style="background-color: {{ section.settings.background_color | default: '#ffffff' }}; padding-top: {{ section.settings.padding_top | default: 88 }}px; padding-bottom: {{ section.settings.padding_bottom | default: 88 }}px;">
  <div class="hb-container">
    {% if section.settings.heading != blank or section.settings.eyebrow != blank %}
      <div class="hb-section-header">
        {% if section.settings.eyebrow != blank %}
          <span class="hb-eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p>{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="hb-routine-grid">
      {% for block in section.blocks %}
        {% if block.type == 'step' %}
          <div class="hb-routine-card" {{ block.shopify_attributes }}>
            <div class="hb-routine-body">
              {% if block.settings.step_number != blank %}
                <span class="hb-routine-step-num">{{ block.settings.step_number }}</span>
              {% endif %}
              {% if block.settings.title != blank %}
                <h3 class="hb-routine-title">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="hb-routine-desc">{{ block.settings.description }}</p>
              {% endif %}
            </div>
            <div class="hb-routine-img">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.title, width: 400, height: 400 }}
              {% elsif block.settings.fallback_image != blank %}
                <img src="{{ block.settings.fallback_image | asset_url }}" alt="{{ block.settings.title | escape }}" width="400" height="400" loading="lazy">
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% assign trust_points = section.blocks | where: "type", "trust_point" %}
    {% if trust_points.size > 0 %}
      <div class="hb-routine-trust-bar">
        {% for block in trust_points %}
          <div class="hb-routine-trust-item" {{ block.shopify_attributes }}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>{{ block.settings.text }}</span>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Daily Routine Steps",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "EASY 3 STEPS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Simple Enough for Every Day."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Incorporate soothing botanical nourishment into your morning routine or post-work relaxation in three effortless steps."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Routine Step",
      "settings": [
        {
          "type": "text",
          "id": "step_number",
          "label": "Step Number",
          "default": "STEP 01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Apply"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Instructions / Description",
          "default": "Dispense 3 to 5 drops directly onto the targeted joint, shoulder, lower back, or muscle area."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step Photo"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "Theme Asset Filename",
          "default": "routine-step-apply.jpg"
        }
      ]
    },
    {
      "type": "trust_point",
      "name": "Trust Feature",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Feature Note",
          "default": "Fast absorption in under 90 seconds"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Daily Routine Steps",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step_number": "STEP 01",
            "title": "Apply",
            "description": "Dispense 3 to 5 drops directly onto the targeted joint, shoulder, lower back, or muscle area.",
            "fallback_image": "routine-step-apply.jpg"
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "STEP 02",
            "title": "Massage",
            "description": "Massage with gentle, firm circular motions for 30 to 60 seconds until absorbed completely into the skin.",
            "fallback_image": "routine-step-massage.jpg"
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "STEP 03",
            "title": "Feel Relief",
            "description": "Notice gentle therapeutic warmth and calming relief spread through tight fibers within 10 to 15 minutes.",
            "fallback_image": "routine-step-relief.jpg"
          }
        },
        {
          "type": "trust_point",
          "settings": {
            "text": "Fast absorption in under 90 seconds"
          }
        },
        {
          "type": "trust_point",
          "settings": {
            "text": "Non-greasy, silky finish"
          }
        },
        {
          "type": "trust_point",
          "settings": {
            "text": "100% Plant-powered therapeutic aroma"
          }
        }
      ]
    }
  ]
}
{% endschema %}
