{{ 'horizon-botanical.css' | asset_url | stylesheet_tag }}

<header class="hb-header-nav" id="header-component">
  <div class="hb-container">
    <div class="hb-header-inner">
      <!-- Mobile Hamburger Button -->
      <button class="hb-mobile-menu-btn" id="hbMobileMenuOpen" aria-label="Open Navigation Menu" type="button">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>

      <!-- Desktop Navigation -->
      <nav class="hb-nav hb-desktop-nav" aria-label="Main Navigation">
        <ul class="hb-nav-links">
          {% if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0 %}
            {% for link in linklists[section.settings.menu].links %}
              <li><a href="{{ link.url }}" class="{% if link.current %}active{% endif %}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="/" class="active">Home</a></li>
            <li><a href="/collections/all">All Products</a></li>
            <li><a href="/pages/contact">Contact</a></li>
          {% endif %}
        </ul>
      </nav>

      <!-- Brand Logo (Centered on mobile) -->
      <div class="hb-header-brand">
        <a href="{{ routes.root_url }}">
          {% if section.settings.logo != blank %}
            <img src="{{ section.settings.logo | image_url: width: 240 }}" alt="{{ shop.name }}" width="150" height="38">
          {% else %}
            <img src="{{ 'horizon-logo.svg' | asset_url }}" alt="{{ shop.name }}" width="150" height="38">
          {% endif %}
        </a>
      </div>

      <!-- Action Icons -->
      <div class="hb-header-actions">
        <a href="{{ routes.search_url }}" class="hb-icon-btn hb-desktop-only" aria-label="Search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </a>
        <a href="{{ routes.account_url }}" class="hb-icon-btn hb-desktop-only" aria-label="Account">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        </a>
        <a href="{{ routes.cart_url }}" class="hb-icon-btn" aria-label="Cart" id="hbCartBtn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
          <span class="hb-cart-count">{{ cart.item_count | default: 0 }}</span>
        </a>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div class="hb-mobile-drawer-overlay" id="hbMobileDrawerOverlay"></div>
<aside class="hb-mobile-drawer" id="hbMobileDrawer" aria-label="Mobile Navigation">
  <div class="hb-mobile-drawer-header">
    <div class="hb-mobile-brand">
      <img src="{{ 'horizon-logo.svg' | asset_url }}" alt="{{ shop.name }}" width="130" height="32">
    </div>
    <button class="hb-mobile-drawer-close" id="hbMobileMenuClose" aria-label="Close Navigation Menu" type="button">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>
  <div class="hb-mobile-drawer-body">
    <ul class="hb-mobile-links">
      <li><a href="/" class="active">Home</a></li>
      <li><a href="/collections/all">All Products</a></li>
      <li><a href="#story">Our Story</a></li>
      <li><a href="#ingredients">Ingredients</a></li>
      <li><a href="#faq">Got Questions?</a></li>
      <li><a href="/pages/contact">Contact Us</a></li>
    </ul>

    <div class="hb-mobile-drawer-footer">
      <a href="/collections/all" class="hb-btn-primary" style="width: 100%; justify-content: center;">Shop Best Sellers</a>
      <div class="hb-mobile-contact">
        <p>Questions? Reach out to us:</p>
        <a href="mailto:hello@tierabotanicals.com">hello@tierabotanicals.com</a>
      </div>
    </div>
  </div>
</aside>

<script>
  (function() {
    const openBtn = document.getElementById('hbMobileMenuOpen');
    const closeBtn = document.getElementById('hbMobileMenuClose');
    const drawer = document.getElementById('hbMobileDrawer');
    const overlay = document.getElementById('hbMobileDrawerOverlay');

    if (!openBtn || !drawer || !overlay) return;

    function openDrawer() {
      drawer.classList.add('active');
      overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      drawer.classList.remove('active');
      overlay.classList.remove('active');
      document.body.style.overflow = '';
    }

    openBtn.addEventListener('click', openDrawer);
    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    overlay.addEventListener('click', closeDrawer);

    drawer.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closeDrawer);
    });
  })();
</script>

{% schema %}
{
  "name": "Header Horizon",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ],
  "presets": [
    {
      "name": "Header Horizon"
    }
  ]
}
{% endschema %}
