{{ 'horizon-botanical.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color | default: '#ffffff' }};
    padding-top: {{ section.settings.padding_top | default: 88 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 88 }}px;
  }

  #shopify-section-{{ section.id }} .hb-section-header .hb-eyebrow {
    color: {{ section.settings.eyebrow_color | default: '#257942' }};
    font-size: {{ section.settings.eyebrow_size | default: 13 }}px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .hb-section-header h2 {
    color: {{ section.settings.heading_color | default: '#111827' }};
    font-size: {{ section.settings.heading_size | default: 38 }}px;
    line-height: 1.25;
    margin: 0 0 16px;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .hb-section-header h2 {
      font-size: {{ section.settings.heading_size_mobile | default: 28 }}px;
    }
  }

  #shopify-section-{{ section.id }} .hb-section-header p {
    color: {{ section.settings.subheading_color | default: '#4b5563' }};
    font-size: {{ section.settings.subheading_size | default: 16 }}px;
    line-height: 1.6;
    max-width: 680px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .hb-trust-grid {
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .hb-trust-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Cards */
  #shopify-section-{{ section.id }} .hb-trust-card {
    background-color: {{ section.settings.card_bg | default: '#ffffff' }};
    border-radius: {{ section.settings.card_radius | default: 16 }}px;
    border: 1px solid {{ section.settings.card_border_color | default: '#e5e7eb' }};
    {% if section.settings.card_shadow %}
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
    {% else %}
      box-shadow: none;
    {% endif %}
    transition: all 0.3s ease;
  }

  {% if section.settings.card_hover_lift %}
    #shopify-section-{{ section.id }} .hb-trust-card:hover {
      transform: translateY(-5px);
      border-color: {{ section.settings.card_hover_border_color | default: '#257942' }};
      {% if section.settings.card_shadow %}
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
      {% endif %}
    }
  {% else %}
    #shopify-section-{{ section.id }} .hb-trust-card:hover {
      border-color: {{ section.settings.card_hover_border_color | default: '#257942' }};
    }
  {% endif %}

  #shopify-section-{{ section.id }} .hb-trust-icon-box {
    width: {{ section.settings.icon_box_size | default: 48 }}px;
    height: {{ section.settings.icon_box_size | default: 48 }}px;
    background-color: {{ section.settings.icon_box_bg | default: '#e8f5e9' }};
    color: {{ section.settings.icon_box_color | default: '#257942' }};
    border-radius: {{ section.settings.icon_box_radius | default: 12 }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .hb-trust-card h3 {
    color: {{ section.settings.card_title_color | default: '#111827' }};
    font-size: {{ section.settings.card_title_size | default: 18 }}px;
    font-weight: 800;
    margin: 0 0 10px;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .hb-trust-card p {
    color: {{ section.settings.card_desc_color | default: '#4b5563' }};
    font-size: {{ section.settings.card_desc_size | default: 14 }}px;
    line-height: 1.6;
    margin: 0;
  }
{%- endstyle -%}

<section class="hb-trust-section" id="why-choose">
  <div class="hb-container">
    {% if section.settings.heading != blank or section.settings.eyebrow != blank %}
      <div class="hb-section-header">
        {% if section.settings.eyebrow != blank %}
          <span class="hb-eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p>{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="hb-trust-grid">
      {% for block in section.blocks %}
        {%- assign blk_icon_bg = block.settings.custom_icon_bg | default: section.settings.icon_box_bg | default: '#e8f5e9' -%}
        {%- assign blk_icon_col = block.settings.custom_icon_color | default: section.settings.icon_box_color | default: '#257942' -%}
        {%- assign blk_title_col = block.settings.custom_title_color | default: section.settings.card_title_color | default: '#111827' -%}

        <div class="hb-trust-card" {{ block.shopify_attributes }}>
          <div class="hb-trust-icon-box" style="background-color: {{ blk_icon_bg }}; color: {{ blk_icon_col }};">
            {% case block.settings.icon %}
              {% when 'shield' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              {% when 'globe' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
              {% when 'clipboard' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
              {% when 'box' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
              {% when 'heart' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              {% when 'truck' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              {% when 'leaf' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
              {% when 'check' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              {% when 'star' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              {% else %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            {% endcase %}
          </div>
          <div>
            {% if block.settings.title != blank %}
              <h3 style="color: {{ blk_title_col }};">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.description != blank %}
              <p>{{ block.settings.description }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Choose Grid",
  "settings": [
    {
      "type": "header",
      "content": "Section Header & Typography"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "WHY ASAR"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#257942"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Eyebrow Font Size",
      "default": 13
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ancient Wellness, Without the Guesswork."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111827"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size (Desktop)",
      "default": 38
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 20,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size (Mobile)",
      "default": 28
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We bring clinical transparency and organic purity to every step of our formulation process."
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#4b5563"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Subheading Font Size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Grid Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 3
    },
    {
      "type": "header",
      "content": "Card Styling"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color",
      "default": "#e5e7eb"
    },
    {
      "type": "color",
      "id": "card_hover_border_color",
      "label": "Card Hover Border Color",
      "default": "#257942"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "card_shadow",
      "label": "Enable Card Shadow",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "card_hover_lift",
      "label": "Enable Hover Lift Effect",
      "default": true
    },
    {
      "type": "header",
      "content": "Icon Box Styling"
    },
    {
      "type": "color",
      "id": "icon_box_bg",
      "label": "Icon Box Background Color",
      "default": "#e8f5e9"
    },
    {
      "type": "color",
      "id": "icon_box_color",
      "label": "Icon Color",
      "default": "#257942"
    },
    {
      "type": "range",
      "id": "icon_box_size",
      "min": 36,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Icon Box Size",
      "default": 48
    },
    {
      "type": "range",
      "id": "icon_box_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Icon Box Border Radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Card Typography"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card Title Color",
      "default": "#111827"
    },
    {
      "type": "range",
      "id": "card_title_size",
      "min": 14,
      "max": 26,
      "step": 1,
      "unit": "px",
      "label": "Card Title Font Size",
      "default": 18
    },
    {
      "type": "color",
      "id": "card_desc_color",
      "label": "Card Description Color",
      "default": "#4b5563"
    },
    {
      "type": "range",
      "id": "card_desc_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Card Description Font Size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Section Styling & Padding"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield (Purity / Safety)" },
            { "value": "globe", "label": "Globe (Sourcing / Origin)" },
            { "value": "clipboard", "label": "Test Report / Clipboard" },
            { "value": "box", "label": "Bottle / Eco Packaging" },
            { "value": "heart", "label": "Heart (Cruelty-Free)" },
            { "value": "truck", "label": "Fast Shipping" },
            { "value": "leaf", "label": "Botanical Leaf" },
            { "value": "check", "label": "Checkmark" },
            { "value": "star", "label": "Star / Premium" }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Clean & Safe Formulas"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "100% free of petroleum, mineral oil, synthetic fragrances, and artificial chemicals. Gentle enough for sensitive skin."
        },
        {
          "type": "color",
          "id": "custom_icon_bg",
          "label": "Custom Icon Box Background (Optional)"
        },
        {
          "type": "color",
          "id": "custom_icon_color",
          "label": "Custom Icon Color (Optional)"
        },
        {
          "type": "color",
          "id": "custom_title_color",
          "label": "Custom Title Color (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Choose Grid",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "shield",
            "title": "Clean & Safe Formulas",
            "description": "100% free of petroleum, mineral oil, synthetic fragrances, and artificial chemicals. Gentle enough for sensitive skin."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "globe",
            "title": "Transparent Sourcing",
            "description": "Every botanical drop is traceable to ethical organic growers with batch certificates of analysis available on request."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "clipboard",
            "title": "Third-Party Tested",
            "description": "Every single harvest is rigorously verified for purity, potency, and zero contaminants by accredited independent laboratories."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "box",
            "title": "Eco-Friendly Bottling",
            "description": "Amber UV-blocking glass preserves volatile essential plant molecules, packaged in 100% recyclable, sustainable boxes."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "heart",
            "title": "Cruelty-Free Always",
            "description": "Never tested on animals. Ethically crafted with care, kindness, and deep reverence for nature and living beings."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "truck",
            "title": "Fast Reliable Shipping",
            "description": "Orders dispatched within 24 hours in secure, discreet packaging with real-time tracking and 30-day money-back satisfaction."
          }
        }
      ]
    }
  ]
}
{% endschema %}
