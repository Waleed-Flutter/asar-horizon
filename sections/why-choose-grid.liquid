<section id="hb-why-{{ section.id }}" class="hb-trust-section" style="
  {% liquid
    assign bg = section.settings.background_color | default: '#ffffff'
    if bg contains 'settings.' or bg contains '{{'
      assign bg = 'var(--color-background, #ffffff)'
    endif
    assign h_col = section.settings.heading_color | default: '#111827'
    assign s_col = section.settings.subheading_color | default: '#4b5563'
    assign eye_col = section.settings.eyebrow_color | default: '#257942'
    assign c_bg = section.settings.card_bg | default: '#fafbf9'
    assign c_rad = section.settings.card_border_radius | default: 14
    assign c_border = section.settings.card_border_color | default: '#e5ece6'
    assign c_title = section.settings.card_title_color | default: '#111827'
    assign c_desc = section.settings.card_desc_color | default: '#4b5563'
    assign i_col = section.settings.icon_color | default: '#257942'
    assign i_bg = section.settings.icon_box_bg | default: '#f2f7f3'
    assign i_rad = section.settings.icon_box_radius | default: 12
  %}
  background-color: {{ bg }};
  padding-top: {{ section.settings.padding_top | default: 88 }}px;
  padding-bottom: {{ section.settings.padding_bottom | default: 88 }}px;
">
  <div class="hb-container">
    {% if section.settings.heading != blank or section.settings.eyebrow != blank %}
      <div class="hb-section-header">
        {% if section.settings.eyebrow != blank %}
          <span class="hb-eyebrow" style="color: {{ eye_col }};">{{ section.settings.eyebrow }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 style="color: {{ h_col }};">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p style="color: {{ s_col }};">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="hb-trust-grid" style="--trust-cols: {{ section.settings.columns_desktop | default: 3 }};">
      {% for block in section.blocks %}
        <div class="hb-trust-card" {{ block.shopify_attributes }} style="
          background-color: {{ c_bg }};
          border-radius: {{ c_rad }}px;
          border-color: {{ c_border }};
        ">
          <div class="hb-trust-icon-box" style="background-color: {{ i_bg }}; color: {{ i_col }}; border-radius: {{ i_rad }}px;">
            {% case block.settings.icon %}
              {% when 'shield' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              {% when 'globe' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
              {% when 'clipboard' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
              {% when 'box' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
              {% when 'heart' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              {% when 'truck' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              {% when 'leaf' %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
              {% else %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            {% endcase %}
          </div>
          <div>
            {% if block.settings.title != blank %}
              <h3 style="color: {{ c_title }};">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.description != blank %}
              <p style="color: {{ c_desc }};">{{ block.settings.description }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Choose Grid",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "WHY US"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#257942"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Natural Wellness, Without the Guesswork."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111827"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We bring clinical transparency and organic purity to every step of our formulation process."
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#4b5563"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 3
    },
    {
      "type": "header",
      "content": "Card Styling"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background Color",
      "default": "#fafbf9"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 14
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color",
      "default": "#e5ece6"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card Title Color",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "card_desc_color",
      "label": "Card Description Color",
      "default": "#4b5563"
    },
    {
      "type": "header",
      "content": "Icon Box Styling"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#257942"
    },
    {
      "type": "color",
      "id": "icon_box_bg",
      "label": "Icon Box Background",
      "default": "#f2f7f3"
    },
    {
      "type": "range",
      "id": "icon_box_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Icon Box Border Radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Section Layout & Padding"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield (Purity / Safety)" },
            { "value": "globe", "label": "Globe (Sourcing / Origin)" },
            { "value": "clipboard", "label": "Test Report / Clipboard" },
            { "value": "box", "label": "Bottle / Eco Packaging" },
            { "value": "heart", "label": "Heart (Cruelty-Free)" },
            { "value": "truck", "label": "Fast Shipping" },
            { "value": "leaf", "label": "Botanical Leaf" }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Clean & Safe Formulas"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "100% free of petroleum, mineral oil, synthetic fragrances, and artificial chemicals. Gentle enough for sensitive skin."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Choose Grid"
    }
  ]
}
{% endschema %}
