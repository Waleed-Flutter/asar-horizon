<section id="hb-story-{{ section.id }}" class="hb-story-section" style="
  {% liquid
    assign bg = section.settings.bg_color | default: '#ffffff'
    if bg contains 'settings.' or bg contains '{{'
      assign bg = 'var(--color-background, #ffffff)'
    endif
    assign h_col = section.settings.heading_color | default: '#111827'
    assign b_col = section.settings.body_color | default: '#4b5563'
    assign eye_col = section.settings.eyebrow_color | default: '#257942'
    assign cta_col = section.settings.cta_color | default: '#257942'
    assign cta_bg = section.settings.cta_btn_bg | default: '#257942'
    assign cta_tc = section.settings.cta_btn_color | default: '#ffffff'
    assign cta_rad = section.settings.cta_btn_radius | default: 30
  %}
  background-color: {{ bg }};
  padding-top: {{ section.settings.padding_top | default: 80 }}px;
  padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
">
  <div class="hb-container">
    <div class="hb-story-grid {% if section.settings.layout == 'image_second' %}hb-grid-reversed{% endif %}">
      <div class="hb-story-visual">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="440" height="440" loading="lazy">
        {% else %}
          <img src="{{ 'horizon-leaf-dew.jpg' | asset_url }}" alt="100% Organic Botanical Leaf" width="440" height="440" loading="lazy">
        {% endif %}

        {% if section.settings.show_badge %}
          <div class="hb-story-badge">
            {% if section.settings.custom_badge != blank %}
              <img src="{{ section.settings.custom_badge | image_url: width: 220 }}" alt="100% Organic Certified" width="110" height="110">
            {% else %}
              <img src="{{ 'horizon-organic-badge.svg' | asset_url }}" alt="100% Organic Certified" width="110" height="110">
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div class="hb-story-content">
        {% if section.settings.eyebrow != blank %}
          <span class="hb-eyebrow" style="color: {{ eye_col }};">{{ section.settings.eyebrow }}</span>
        {% endif %}
        <h2 style="color: {{ h_col }};">{{ section.settings.heading }}</h2>
        <div class="hb-story-body" style="color: {{ b_col }};">
          {{ section.settings.body_text }}
        </div>

        {% if section.settings.cta_text != blank %}
          {% if section.settings.cta_style == 'button' %}
            <div style="margin-top: 24px;">
              <a href="{{ section.settings.cta_link | default: '/pages/about' }}" class="hb-btn-primary" style="
                background-color: {{ cta_bg }} !important;
                color: {{ cta_tc }} !important;
                border-radius: {{ cta_rad }}px !important;
              ">
                {{ section.settings.cta_text }}
              </a>
            </div>
          {% else %}
            <a href="{{ section.settings.cta_link | default: '/pages/about' }}" class="hb-btn-link" style="color: {{ cta_col }} !important; padding-left: 0;">
              {{ section.settings.cta_text }} &rarr;
            </a>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature Organic Story",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop Layout",
      "options": [
        { "value": "image_first", "label": "Image on Left" },
        { "value": "image_second", "label": "Image on Right" }
      ],
      "default": "image_first"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Featured Botanical Image"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show Rotating Organic Badge",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "custom_badge",
      "label": "Custom Badge Graphic (Optional)"
    },
    {
      "type": "header",
      "content": "Story Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "THE SCIENCE OF NATURE"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#257942"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wellness Should Be Part of Everyday Life"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111827"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Story Body Copy",
      "default": "<p>We believe physical relief should be pure, natural, and accessible. Our bio-active extraction process preserves vital botanical terpenes and fatty acids for deep transdermal absorption.</p><p>From morning stiffness to post-activity recovery, our clean plant formula works with your body's natural physiology to calm tension at the source without synthetic blockers or greasy residue.</p>"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body Text Color",
      "default": "#4b5563"
    },
    {
      "type": "header",
      "content": "CTA Button / Link"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Link Text",
      "default": "Discover Our Story"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link URL"
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "CTA Display Style",
      "options": [
        { "value": "link", "label": "Text Link with Arrow" },
        { "value": "button", "label": "Solid Button" }
      ],
      "default": "link"
    },
    {
      "type": "color",
      "id": "cta_color",
      "label": "Link Text Color (if Text Link)",
      "default": "#257942"
    },
    {
      "type": "color",
      "id": "cta_btn_bg",
      "label": "Button Background (if Solid Button)",
      "default": "#257942"
    },
    {
      "type": "color",
      "id": "cta_btn_color",
      "label": "Button Text Color (if Solid Button)",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "cta_btn_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Button Border Radius",
      "default": 30
    },
    {
      "type": "header",
      "content": "Section Layout & Padding"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Feature Organic Story"
    }
  ]
}
{% endschema %}
