{{ 'horizon-botanical.css' | asset_url | stylesheet_tag }}

<section class="hb-story-section" id="story">
  <div class="hb-container">
    <div class="hb-story-grid">
      <div class="hb-story-visual">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" width="440" height="440" loading="lazy">
        {% else %}
          <img src="{{ 'horizon-leaf-dew.jpg' | asset_url }}" alt="100% Organic Botanical Leaf" width="440" height="440" loading="lazy">
        {% endif %}

        <div class="hb-story-badge">
          <img src="{{ 'horizon-organic-badge.svg' | asset_url }}" alt="100% Organic Certified" width="110" height="110">
        </div>
      </div>

      <div class="hb-story-content">
        <span class="hb-eyebrow">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.paragraph_1 }}</p>
        {% if section.settings.paragraph_2 != blank %}
          <p>{{ section.settings.paragraph_2 }}</p>
        {% endif %}

        <a href="{{ section.settings.cta_link | default: '/pages/about' }}" class="hb-btn-link" style="padding-left: 0;">
          {{ section.settings.cta_text }} &rarr;
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature Organic Story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "THE SCIENCE OF NATURE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wellness Should Be Part of Everyday Life"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1",
      "default": "We believe physical relief should be pure, natural, and accessible. Our bio-active extraction process preserves vital botanical terpenes and fatty acids for deep transdermal absorption."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2",
      "default": "From morning stiffness to post-activity recovery, our clean formula works with your body's natural physiology to calm tension at the source without synthetic blockers or greasy residue."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Link Text",
      "default": "Discover Our Story"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section Image"
    }
  ],
  "presets": [
    {
      "name": "Feature Organic Story"
    }
  ]
}
{% endschema %}
