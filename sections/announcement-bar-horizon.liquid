{{ 'horizon-botanical.css' | asset_url | stylesheet_tag }}

{% if section.settings.show_announcement %}
  <div class="hb-announcement" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
    <div class="hb-container">
      {{ section.settings.text }}
    </div>
  </div>
{% endif %}

{% endschema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "Free shipping on orders over $50 | 100% Satisfaction Guarantee"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#257942"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}
