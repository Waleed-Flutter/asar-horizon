<section id="hb-announcement-{{ section.id }}" class="hb-announcement-wrapper" style="
  {% liquid
    assign bg = section.settings.bg_color
    if bg == blank or bg == 'rgba(0,0,0,0)'
      assign bg = '#257942'
    elsif bg contains 'settings.' or bg contains '{{'
      assign bg = 'var(--color-background, #257942)'
    endif
    assign tc = section.settings.text_color
    if tc == blank or tc == 'rgba(0,0,0,0)'
      assign tc = '#ffffff'
    elsif tc contains 'settings.' or tc contains '{{'
      assign tc = '#ffffff'
    endif
  %}
  background-color: {{ bg }};
  color: {{ tc }};
  padding-top: {{ section.settings.padding_vertical | default: 9 }}px;
  padding-bottom: {{ section.settings.padding_vertical | default: 9 }}px;
  font-size: {{ section.settings.font_size | default: 13 }}px;
  letter-spacing: {{ section.settings.letter_spacing | default: 0 }}px;
  font-weight: {{ section.settings.font_weight | default: 500 }};
">
  {% if section.settings.show_announcement %}
    <div class="hb-announcement" style="background: transparent; color: inherit; padding: 0;">
      <div class="hb-container">
        {% if section.settings.link != blank %}
          <a href="{{ section.settings.link }}" style="color: inherit; text-decoration: none;">
            {{ section.settings.text }}
          </a>
        {% else %}
          {{ section.settings.text }}
        {% endif %}
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "Free shipping on orders over $50 | 100% Satisfaction Guarantee"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Announcement Link (Optional)"
    },
    {
      "type": "header",
      "content": "Colors & Typography"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#257942"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Font Size",
      "default": 13
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font Weight",
      "options": [
        { "value": "400", "label": "Regular 400" },
        { "value": "500", "label": "Medium 500" },
        { "value": "600", "label": "Semi-Bold 600" },
        { "value": "700", "label": "Bold 700" }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": 0,
      "max": 3,
      "step": 0.5,
      "unit": "px",
      "label": "Letter Spacing",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 4,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 9
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}
