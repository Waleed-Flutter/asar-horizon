{{ 'horizon-botanical.css' | asset_url | stylesheet_tag }}

{% if section.settings.show_announcement %}
  <div class="hb-announcement" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; padding-top: {{ section.settings.padding_vertical }}px; padding-bottom: {{ section.settings.padding_vertical }}px; font-size: {{ section.settings.font_size }}px;">
    <div class="hb-container">
      {% if section.settings.link != blank %}
        <a href="{{ section.settings.link }}" style="color: inherit; text-decoration: none;">
          {{ section.settings.text }}
        </a>
      {% else %}
        {{ section.settings.text }}
      {% endif %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "Free shipping on orders over $50 | 100% Satisfaction Guarantee"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Announcement Link (Optional)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#257942"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 11,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Font Size",
      "default": 13
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 4,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 9
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}
